#!/usr/bin/env bash
# kaban git hook: post-commit (core-spec F13 provenance; core-plan C5.3 as amended by M5-14,
# M5-15 and owner decision OWN-23). Stamps `commit_sha = HEAD` on the records of this
# repository's workspace that no commit stamped yet (`kaban hook post-commit`); the next `sync`
# (the pre-commit hook of the following commit) re-serializes them with their provenance.
#
# - exit 0 whatever happens; a post-commit hook cannot affect the commit anyway, and kaban's
#   hook contract already answers `{}` and exits 0 on every failure (hooks/README.md);
# - no envelope: `kaban hook post-commit` reads nothing from stdin (git sends no JSON and may
#   leave stdin on a terminal); `</dev/null` is belt and braces; `--stdin-json` is the recipes'
#   spelling and is ignored by this event;
# - `timeout 5` where GNU coreutils provides it; kaban's own 1.8 s watchdog answers first;
# - `KABAN_BIN`, `KABAN_DB` (default `<repository root>/kaban.db`), `KABAN_HOME`,
#   `KABAN_WORKSPACE` as for pre-commit. A hook never creates a database.
#
# Install: `git config core.hooksPath hooks/git`, or copy to `.git/hooks/post-commit`.
set -u
KABAN_BIN="${KABAN_BIN:-kaban}"
command -v "$KABAN_BIN" >/dev/null 2>&1 || exit 0
if command -v timeout >/dev/null 2>&1; then
  timeout 5 "$KABAN_BIN" hook post-commit --stdin-json </dev/null >/dev/null 2>&1 || exit 0
else
  "$KABAN_BIN" hook post-commit --stdin-json </dev/null >/dev/null 2>&1 || exit 0
fi
exit 0
