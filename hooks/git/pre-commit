#!/usr/bin/env bash
# kaban git hook: pre-commit (core-spec F9b, F13; core-plan C5.3 as amended by M5-19, M5-29).
# Writes the stale `.kaban/<ontology>/<dir>/<id>.md` records and the per-ontology digests
# `.kaban/<ontology>/INDEX.md` (the shipped ontology: `.kaban/adr/decisions/`, `.kaban/adr/INDEX.md`)
# from the database and stages them (`kaban sync --stage`), so the serialization lands in the
# commit being made; the first run under the engine also moves a pre-engine `.kaban/<dir>/`
# layout once (`git mv`, engine-plan E1.6).
#
# - exit 0 whatever happens: a missing binary, a missing database, a lock, a slow sync or any
#   error never aborts the commit (PR-9 class); the files simply land in a later commit;
# - `timeout 10` where GNU coreutils provides it (Linux); on macOS the command runs bare;
# - stdin, stdout and stderr are detached from git (`</dev/null >/dev/null 2>&1`): a hook
#   prints nothing, so `git commit` output stays git's own;
# - the database and the audit keys come from the environment the MCP server uses: `KABAN_DB`
#   (default `<repository root>/kaban.db`, since git runs hooks from the root), `KABAN_HOME`
#   (default `~/.kaban`), `KABAN_WORKSPACE` (default: the root directory's name). `KABAN_BIN`
#   names the binary when `kaban` is not on `PATH`.
# - partial commits (`git commit <paths>`): git builds the commit from a temporary index that
#   this hook cannot stage into, so the serialization lands in the next commit (M5-29).
#
# Install: `git config core.hooksPath hooks/git` (every hook of this directory), or copy this
# file to `.git/hooks/pre-commit` (keep it executable). See hooks/README.md.
set -u
KABAN_BIN="${KABAN_BIN:-kaban}"
command -v "$KABAN_BIN" >/dev/null 2>&1 || exit 0
if command -v timeout >/dev/null 2>&1; then
  timeout 10 "$KABAN_BIN" sync --stage --json </dev/null >/dev/null 2>&1 || exit 0
else
  "$KABAN_BIN" sync --stage --json </dev/null >/dev/null 2>&1 || exit 0
fi
exit 0
