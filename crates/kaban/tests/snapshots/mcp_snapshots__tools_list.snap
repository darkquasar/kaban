              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "start_col",
            "end_line",
            "end_col"
          ],
          "type": "object"
        },
        "CoverageSummary": {
          "description": "The compact coverage field of every `code_*` response: what the snapshot holds and what\nthe producer left out, with one plain sentence when anything is missing.",
          "properties": {
            "block_items_unique": {
              "description": "Distinct items inside function bodies and macro expansions that have no identity in\nthe graph (`coverage:block_items_unique`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "declarations": {
              "description": "Declarations the producer published (`coverage:declarations`); 0 when the snapshot\ncarries no coverage rows.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "incomplete_modules": {
              "description": "Modules indexed with an unresolved import, module or macro, whose references are\npartial (`coverage:incomplete_modules`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "note": {
              "description": "One sentence when any gap counter is non-zero: what is not indexed, and that an empty\nanswer does not prove absence. Absent otherwise.",
              "type": [
                "string",
                "null"
              ]
            },
            "skipped_targets": {
              "description": "Cargo targets skipped for inactive `required-features` (`coverage:targets_skipped`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "declarations",
            "block_items_unique",
            "incomplete_modules",
            "skipped_targets"
          ],
          "type": "object"
        },
        "FollowUp": {
          "description": "A suggestion the agent may execute with another tool (core-spec F19). kaban never runs it.",
          "properties": {
            "args": {
              "description": "Arguments for that tool, built from the masked `CodeRef` props."
            },
            "reason": {
              "description": "Why the suggestion is made (names the pointer, never a node id).",
              "type": "string"
            },
            "tool": {
              "$ref": "#/$defs/FollowUpTool",
              "description": "The tool to call."
            }
          },
          "required": [
            "tool",
            "args",
            "reason"
          ],
          "type": "object"
        },
        "FollowUpTool": {
          "description": "Tools a follow-up may name (closed set; the wire form is the dotted tool name).",
          "oneOf": [
            {
              "const": "serena.find_symbol",
              "description": "Serena `find_symbol` (`name_path` + `relative_path`).",
              "type": "string"
            },
            {
              "const": "serena.find_referencing_symbols",
              "description": "Serena `find_referencing_symbols` (`name_path` + `relative_path`).",
              "type": "string"
            }
          ]
        },
        "SnapshotRefWire": {
          "description": "The resolved snapshot every `code_*` response reports (stage1-spec G1-F8, §6\n`SnapshotRef`; cg-join-v1 §4): the wire form of [`kaban_codegraph::SnapshotRef`].",
          "properties": {
            "commit": {
              "description": "The snapshot's commit, 40 lowercase hex.",
              "type": "string"
            },
            "exact": {
              "description": "Whether it is the snapshot of the current `HEAD` (else the nearest ancestor's).",
              "type": "boolean"
            },
            "isolation": {
              "description": "The isolation tier the indexer ran under: `namespaces | container | none`.",
              "type": "string"
            },
            "policy": {
              "description": "`current` when the snapshot was built under the live denylist policy, `off` when the\ncontent scan was disabled at index time (nothing was gated), else `stale`.",
              "type": "string"
            },
            "schema_version": {
              "description": "The snapshot's schema major.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "commit",
            "exact",
            "schema_version",
            "policy",
            "isolation"
          ],
          "type": "object"
        },
        "TargetNote": {
          "description": "How the name selector reached its node when not by an exact `(label, name)` match (Q-2,\nbacklog 21; R-3 consumer request 2): the one node of another label that carries the\nname (`label_corrected` names the label that answered), or the external placeholder matched\nby name (`external`). A response carries it only in those two cases.",
          "properties": {
            "external": {
              "description": "The node is an external placeholder (defined outside the repository, label unknown).",
              "type": "boolean"
            },
            "label_corrected": {
              "description": "The label that answered when the request named another one.",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "The node that answered (pass it back as `target.ref`).",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "external"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageSummary",
          "description": "What the snapshot does not cover (R-1): zeros and no note without coverage rows."
        },
        "definition": {
          "$ref": "#/$defs/CodeNode",
          "description": "The node with its definition range, signature and doc."
        },
        "follow_ups": {
          "description": "Suggested next calls (none are synthesised in 3.0.0, OWN-68 SC-09).",
          "items": {
            "$ref": "#/$defs/FollowUp"
          },
          "type": "array"
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotRefWire",
          "description": "The snapshot the card comes from."
        },
        "target_note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetNote"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the name selector did beyond an exact match (Q-2): the node of another label it\nanswered (`label_corrected`), or an external placeholder matched by name (`external`);\nabsent when the target matched as asked."
        }
      },
      "required": [
        "snapshot",
        "coverage",
        "definition",
        "follow_ups"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Code implementers"
    },
    "description": "Implementers of an interface or type in the code-graph snapshot of the current commit: the target is exactly one of symbol (the normalised SCIP key), ref (an exact row ref), {label, name} (exact, case-sensitive; add path to keep one file; several matches answer ambiguous_symbol with the candidates to pick a ref from; an external trait or interface answers by name too, target_note.external true) or {path, line}; results are CodeNode cards sorted by path then ref (default 50, max 200, truncated flag), external implementers only with include_external.",
    "inputSchema": {
      "$defs": {
        "SymbolSelector": {
          "additionalProperties": false,
          "description": "The target of a `code_*` tool (stage1-spec §6, G1-F12, RS-12): exactly one of `symbol`,\n`ref`, `{label, name}` (with an optional `path` keeping one file), `{path, line}` or `path`\n(where the tool allows it); anything else is `selector_invalid`. Name lookups are exact and\ncase-sensitive; a name matching several nodes is `ambiguous_symbol` with the candidates\n(Q-2), never a merged answer; a wrong label corrects to the one other kind of that name\n(`target_note.label_corrected`) or suggests `did_you_mean`; an external placeholder\n(a dependency's trait) answers by name whatever label it lacks (`target_note.external`).",
          "properties": {
            "label": {
              "description": "A SCIP kind name or `File`, together with `name` (control: closed enum).",
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "description": "A 0-based line in `path`.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "description": "The exact display name, together with `label` (content).",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "A repository-relative path: with `line` the nodes defined at that line, with `{label,\nname}` the file the named node must be defined in, alone the file node (content).",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "The exact row identity in this snapshot: `scip:<scip>`, `local:<path>:<scip>` or\n`file:<path>` (content; the discriminated parse runs after the scan).",
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "description": "The normalised cross-commit SCIP key (content; grammar-checked after the scan).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "current_path": {
          "description": "The caller's current file, a repository-relative path: results are ranked by path\ndistance from it (content; G1-F16).",
          "type": [
            "string",
            "null"
          ]
        },
        "include_external": {
          "default": false,
          "description": "Include implementers defined outside the repository (default false).",
          "type": "boolean"
        },
        "include_snippets": {
          "default": false,
          "description": "Include each card's snippet (G1-F17).",
          "type": "boolean"
        },
        "limit": {
          "description": "Max rows (default 50, max 200); `truncated: true` says more existed.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/SymbolSelector",
          "description": "The interface or type whose `IMPLEMENTS` sources are listed (`path` alone is not\nallowed here)."
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "name": "code_implementers",
    "outputSchema": {
      "$defs": {
        "CodeNode": {
          "description": "One node card (stage1-spec §6 `CodeNode`). Field classes per §6.1: `kind`, `label` and\n`language` are control (closed enums), every other string is content.",
          "properties": {
            "distance": {
              "description": "Path distance from the request's `current_path` (G1-F16): 0 for the same file (and\nwithout `current_path`, or for a card without a path), 1 for the same directory, else 2\nplus the directory components of both outside their longest common prefix.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "doc": {
              "description": "Documentation text.",
              "type": [
                "string",
                "null"
              ]
            },
            "enclosing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CodeRange"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Enclosing range (the body)."
            },
            "external": {
              "description": "Defined outside the repository.",
              "type": "boolean"
            },
            "is_test": {
              "description": "Defined in a test file.",
              "type": "boolean"
            },
            "kind": {
              "description": "`symbol | local | file`.",
              "type": "string"
            },
            "label": {
              "description": "SCIP kind name or `File`.",
              "type": "string"
            },
            "language": {
              "description": "`go | typescript | javascript`.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "path": {
              "description": "Repository-relative path of the defining file (`null` for an external placeholder).",
              "type": [
                "string",
                "null"
              ]
            },
            "range": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CodeRange"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Definition range."
            },
            "raw": {
              "description": "The versioned SCIP symbol as the indexer emitted it.",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "Exact row identity in this snapshot (pass it back as `target.ref`).",
              "type": "string"
            },
            "signature": {
              "description": "Signature text.",
              "type": [
                "string",
                "null"
              ]
            },
            "snippet": {
              "description": "Source snippet (G1-F17): `code_definition` always, the list tools with `include_snippets`; `null` when the snapshot holds none.",
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "description": "The normalised cross-commit key, `kind = symbol` and not external only (G1-F9); pass\nit to `remember` or back as `target.symbol`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "ref",
            "symbol",
            "raw",
            "label",
            "name",
            "path",
            "language",
            "range",
            "enclosing",
            "signature",
            "doc",
            "snippet",
            "external",
            "is_test",
            "distance"
          ],
          "type": "object"
        },
        "CodeRange": {
          "description": "A source range in SCIP coordinates: 0-based lines and columns, end exclusive\n(stage1-spec §6 `Range`).",
          "properties": {
            "end_col": {
              "description": "End column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "end_line": {
              "description": "End line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_col": {
              "description": "Start column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "description": "Start line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "start_col",
            "end_line",
            "end_col"
          ],
          "type": "object"
        },
        "CoverageSummary": {
          "description": "The compact coverage field of every `code_*` response: what the snapshot holds and what\nthe producer left out, with one plain sentence when anything is missing.",
          "properties": {
            "block_items_unique": {
              "description": "Distinct items inside function bodies and macro expansions that have no identity in\nthe graph (`coverage:block_items_unique`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "declarations": {
              "description": "Declarations the producer published (`coverage:declarations`); 0 when the snapshot\ncarries no coverage rows.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "incomplete_modules": {
              "description": "Modules indexed with an unresolved import, module or macro, whose references are\npartial (`coverage:incomplete_modules`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "note": {
              "description": "One sentence when any gap counter is non-zero: what is not indexed, and that an empty\nanswer does not prove absence. Absent otherwise.",
              "type": [
                "string",
                "null"
              ]
            },
            "skipped_targets": {
              "description": "Cargo targets skipped for inactive `required-features` (`coverage:targets_skipped`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "declarations",
            "block_items_unique",
            "incomplete_modules",
            "skipped_targets"
          ],
          "type": "object"
        },
        "FollowUp": {
          "description": "A suggestion the agent may execute with another tool (core-spec F19). kaban never runs it.",
          "properties": {
            "args": {
              "description": "Arguments for that tool, built from the masked `CodeRef` props."
            },
            "reason": {
              "description": "Why the suggestion is made (names the pointer, never a node id).",
              "type": "string"
            },
            "tool": {
              "$ref": "#/$defs/FollowUpTool",
              "description": "The tool to call."
            }
          },
          "required": [
            "tool",
            "args",
            "reason"
          ],
          "type": "object"
        },
        "FollowUpTool": {
          "description": "Tools a follow-up may name (closed set; the wire form is the dotted tool name).",
          "oneOf": [
            {
              "const": "serena.find_symbol",
              "description": "Serena `find_symbol` (`name_path` + `relative_path`).",
              "type": "string"
            },
            {
              "const": "serena.find_referencing_symbols",
              "description": "Serena `find_referencing_symbols` (`name_path` + `relative_path`).",
              "type": "string"
            }
          ]
        },
        "SnapshotRefWire": {
          "description": "The resolved snapshot every `code_*` response reports (stage1-spec G1-F8, §6\n`SnapshotRef`; cg-join-v1 §4): the wire form of [`kaban_codegraph::SnapshotRef`].",
          "properties": {
            "commit": {
              "description": "The snapshot's commit, 40 lowercase hex.",
              "type": "string"
            },
            "exact": {
              "description": "Whether it is the snapshot of the current `HEAD` (else the nearest ancestor's).",
              "type": "boolean"
            },
            "isolation": {
              "description": "The isolation tier the indexer ran under: `namespaces | container | none`.",
              "type": "string"
            },
            "policy": {
              "description": "`current` when the snapshot was built under the live denylist policy, `off` when the\ncontent scan was disabled at index time (nothing was gated), else `stale`.",
              "type": "string"
            },
            "schema_version": {
              "description": "The snapshot's schema major.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "commit",
            "exact",
            "schema_version",
            "policy",
            "isolation"
          ],
          "type": "object"
        },
        "TargetNote": {
          "description": "How the name selector reached its node when not by an exact `(label, name)` match (Q-2,\nbacklog 21; R-3 consumer request 2): the one node of another label that carries the\nname (`label_corrected` names the label that answered), or the external placeholder matched\nby name (`external`). A response carries it only in those two cases.",
          "properties": {
            "external": {
              "description": "The node is an external placeholder (defined outside the repository, label unknown).",
              "type": "boolean"
            },
            "label_corrected": {
              "description": "The label that answered when the request named another one.",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "The node that answered (pass it back as `target.ref`).",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "external"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "Rows returned.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageSummary",
          "description": "What the snapshot does not cover (R-1): zeros and no note without coverage rows."
        },
        "follow_ups": {
          "description": "Suggested next calls (none are synthesised in 3.0.0, OWN-68 SC-09).",
          "items": {
            "$ref": "#/$defs/FollowUp"
          },
          "type": "array"
        },
        "ranking": {
          "description": "`full` (the complete candidate set was ranked) or `partial`.",
          "type": "string"
        },
        "results": {
          "description": "The cards, ranked (G1-F16) before the limit was applied.",
          "items": {
            "$ref": "#/$defs/CodeNode"
          },
