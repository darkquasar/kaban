            "raw",
            "label",
            "name",
            "path",
            "language",
            "range",
            "enclosing",
            "signature",
            "doc",
            "snippet",
            "external",
            "is_test",
            "distance"
          ],
          "type": "object"
        },
        "CodeRange": {
          "description": "A source range in SCIP coordinates: 0-based lines and columns, end exclusive\n(stage1-spec §6 `Range`).",
          "properties": {
            "end_col": {
              "description": "End column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "end_line": {
              "description": "End line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_col": {
              "description": "Start column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "description": "Start line.",
              "format": "uint32",
              "minimum": 0,
