            "end_line": {
              "description": "End line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_col": {
              "description": "Start column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "description": "Start line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "start_col",
            "end_line",
            "end_col"
          ],
          "type": "object"
        },
        "CoverageSummary": {
          "description": "The compact coverage field of every `code_*` response: what the snapshot holds and what\nthe producer left out, with one plain sentence when anything is missing.",
          "properties": {
            "block_items_unique": {
              "description": "Distinct items inside function bodies and macro expansions that have no identity in\nthe graph (`coverage:block_items_unique`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "declarations": {
              "description": "Declarations the producer published (`coverage:declarations`); 0 when the snapshot\ncarries no coverage rows.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "incomplete_modules": {
              "description": "Modules indexed with an unresolved import, module or macro, whose references are\npartial (`coverage:incomplete_modules`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "note": {
              "description": "One sentence when any gap counter is non-zero: what is not indexed, and that an empty\nanswer does not prove absence. Absent otherwise.",
              "type": [
                "string",
                "null"
              ]
            },
            "skipped_targets": {
              "description": "Cargo targets skipped for inactive `required-features` (`coverage:targets_skipped`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "declarations",
            "block_items_unique",
            "incomplete_modules",
            "skipped_targets"
          ],
          "type": "object"
        },
        "FollowUp": {
          "description": "A suggestion the agent may execute with another tool (core-spec F19). kaban never runs it.",
          "properties": {
            "args": {
              "description": "Arguments for that tool, built from the masked `CodeRef` props."
            },
            "reason": {
              "description": "Why the suggestion is made (names the pointer, never a node id).",
              "type": "string"
            },
            "tool": {
              "$ref": "#/$defs/FollowUpTool",
              "description": "The tool to call."
            }
          },
          "required": [
            "tool",
            "args",
            "reason"
          ],
          "type": "object"
        },
        "FollowUpTool": {
          "description": "Tools a follow-up may name (closed set; the wire form is the dotted tool name).",
          "oneOf": [
            {
              "const": "serena.find_symbol",
              "description": "Serena `find_symbol` (`name_path` + `relative_path`).",
              "type": "string"
            },
            {
              "const": "serena.find_referencing_symbols",
              "description": "Serena `find_referencing_symbols` (`name_path` + `relative_path`).",
              "type": "string"
            }
          ]
        },
        "SnapshotRefWire": {
          "description": "The resolved snapshot every `code_*` response reports (stage1-spec G1-F8, §6\n`SnapshotRef`; cg-join-v1 §4): the wire form of [`kaban_codegraph::SnapshotRef`].",
          "properties": {
            "commit": {
              "description": "The snapshot's commit, 40 lowercase hex.",
              "type": "string"
            },
            "exact": {
              "description": "Whether it is the snapshot of the current `HEAD` (else the nearest ancestor's).",
              "type": "boolean"
            },
            "isolation": {
              "description": "The isolation tier the indexer ran under: `namespaces | container | none`.",
              "type": "string"
            },
            "policy": {
              "description": "`current` when the snapshot was built under the live denylist policy, `off` when the\ncontent scan was disabled at index time (nothing was gated), else `stale`.",
              "type": "string"
            },
            "schema_version": {
              "description": "The snapshot's schema major.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "commit",
            "exact",
            "schema_version",
            "policy",
            "isolation"
          ],
          "type": "object"
        },
        "TargetNote": {
          "description": "How the name selector reached its node when not by an exact `(label, name)` match (Q-2,\nbacklog 21; R-3 consumer request 2): the one node of another label that carries the\nname (`label_corrected` names the label that answered), or the external placeholder matched\nby name (`external`). A response carries it only in those two cases.",
          "properties": {
            "external": {
              "description": "The node is an external placeholder (defined outside the repository, label unknown).",
              "type": "boolean"
            },
            "label_corrected": {
              "description": "The label that answered when the request named another one.",
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "description": "The node that answered (pass it back as `target.ref`).",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "external"
          ],
          "type": "object"
        },
        "TestLink": {
          "description": "One test link (stage1-spec §6 `TestLink`, G1-F6): how a `TESTED_BY` edge was derived, and\nwhich tier of `code_tests_for` it comes from (TESTS-1).",
          "properties": {
            "heuristic": {
              "description": "`true` for the naming form and the textual tier, which may be wrong by construction.",
              "type": "boolean"
            },
            "how": {
              "$ref": "#/$defs/TestTier",
              "description": "The tier."
            },
            "matched_by": {
              "description": "`reference` (the test's body references the symbol) or `naming` (file stems match, or\nthe textual tier's names match).",
              "type": "string"
            },
            "test": {
              "$ref": "#/$defs/CodeNode",
              "description": "The test function, method or test file node."
            },
            "via": {
              "description": "The ref of the caller a `via` link reaches the target through; absent otherwise.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "test",
            "matched_by",
            "heuristic",
            "how"
          ],
          "type": "object"
        },
        "TestTier": {
          "description": "The tier of a test link (TESTS-1; `tests[].how`, a `ctl Enum`): the wire form of\n[`kaban_codegraph::How`].",
          "oneOf": [
            {
              "const": "direct",
              "description": "The target's own `TESTED_BY` edge.",
              "type": "string"
            },
            {
              "const": "via",
              "description": "A `TESTED_BY` edge of a caller of the target, one `REFERENCES` hop; `via` names the\ncaller.",
              "type": "string"
            },
            {
              "const": "textual",
              "description": "A test whose path or snippet spells every word of the target's name: a heuristic,\nanswered only when `direct` and `via` are both empty.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageSummary",
          "description": "What the snapshot does not cover (R-1): zeros and no note without coverage rows."
        },
        "follow_ups": {
          "description": "Suggested next calls (none are synthesised in 3.0.0, OWN-68 SC-09).",
          "items": {
            "$ref": "#/$defs/FollowUp"
          },
          "type": "array"
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotRefWire",
          "description": "The snapshot the links come from."
        },
        "target_note": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetNote"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the name selector did beyond an exact match (Q-2): the node of another label it\nanswered (`label_corrected`), or an external placeholder matched by name (`external`);\nabsent when the target matched as asked."
        },
        "tests": {
          "description": "The links.",
          "items": {
            "$ref": "#/$defs/TestLink"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Links beyond the limit existed.",
          "type": "boolean"
        }
      },
      "required": [
        "snapshot",
        "coverage",
        "tests",
        "truncated",
        "follow_ups"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Forget"
    },
    "description": "Forget a node: tombstone (default; keeps history, hidden from every read, never re-proposed as a duplicate), invalidate (tombstone plus governance invalidated with an event), archive (reachable by id and graph expansion only), or purge (destructive; removes text, index entries and edges, the id never reappears).",
    "inputSchema": {
      "$defs": {
        "ForgetMode": {
          "description": "How to forget a node (core-spec F5).",
          "oneOf": [
            {
              "const": "tombstone",
              "description": "Keep history, hide from every default read, never re-propose as a duplicate (default).\nLifecycle only: governance is untouched and no event is written.",
              "type": "string"
            },
            {
              "const": "invalidate",
              "description": "Tombstone and, for governed kinds, mark the record `invalidated` with an event (OD-4:\nnon-governed kinds get the event too).",
              "type": "string"
            },
            {
              "const": "archive",
              "description": "Archive: reachable by id and through graph expansion, out of the text index.",
              "type": "string"
            },
            {
              "const": "purge",
              "description": "Destructive: remove text, index entries and edges; the id row stays as `purged`.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Node id.",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForgetMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "tombstone (default: hidden, never re-proposed) | invalidate (tombstone plus governance\n`invalidated` with an event) | archive | purge (destructive: removes text, index entries\nand edges; the id never reappears)"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "forget",
    "outputSchema": {
      "$defs": {
        "ForgetMode": {
          "description": "How to forget a node (core-spec F5).",
          "oneOf": [
            {
              "const": "tombstone",
              "description": "Keep history, hide from every default read, never re-propose as a duplicate (default).\nLifecycle only: governance is untouched and no event is written.",
              "type": "string"
            },
            {
              "const": "invalidate",
              "description": "Tombstone and, for governed kinds, mark the record `invalidated` with an event (OD-4:\nnon-governed kinds get the event too).",
              "type": "string"
            },
            {
              "const": "archive",
              "description": "Archive: reachable by id and through graph expansion, out of the text index.",
              "type": "string"
            },
            {
              "const": "purge",
              "description": "Destructive: remove text, index entries and edges; the id row stays as `purged`.",
              "type": "string"
            }
          ]
        },
        "Governance": {
          "description": "Governance state of a `Decision`, `Convention` or `Failure`; [`Governance::None`] for every\nother kind.",
          "oneOf": [
            {
              "const": "none",
              "description": "The kind is not governed.",
              "type": "string"
            },
            {
              "const": "proposed",
              "description": "Recorded, not yet accepted (ranked below accepted in `why`).",
              "type": "string"
            },
            {
              "const": "accepted",
              "description": "Accepted with reason and path scope (event recorded).",
              "type": "string"
            },
            {
              "const": "superseded",
              "description": "Replaced by a newer record (`SUPERSEDES` edge plus event).",
              "type": "string"
            },
            {
              "const": "invalidated",
              "description": "Declared no longer valid (event recorded).",
              "type": "string"
            }
          ]
        },
        "Lifecycle": {
          "description": "Storage visibility of a node. Reads default to [`Lifecycle::Active`].",
          "oneOf": [
            {
              "const": "active",
              "description": "Visible to recall, traverse and get.",
              "type": "string"
            },
            {
              "const": "archived",
              "description": "Kept and reachable through graph expansion or `include_archived`; not in the text index.",
              "type": "string"
            },
            {
              "const": "tombstoned",
              "description": "Hidden everywhere; never re-proposed as a duplicate. Terminal except for purge.",
              "type": "string"
            },
            {
              "const": "purged",
              "description": "Text, index entries and edges removed; only the id row remains so it never reappears.",
              "type": "string"
            }
          ]
        },
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). On FTS5 the index is written in the\nmutation's own transaction, so a commit is searchable at once. An index with its own\nstorage (Tantivy, SS-09) publishes behind the commit: the service waits one bounded\nbarrier for the serving reader to cover the receipt's position and otherwise reports the\nthird outcome, which is never a rejection and is never replayed. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            },
            {
              "const": "committed_not_yet_searchable",
              "description": "Committed, and the search index had not incorporated the receipt's position when the\nvisibility barrier expired or failed: the write stands, a later search will show it,\ndo not replay the mutation. CLI status 6.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected`, `committed` or `committed_not_yet_searchable` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cleanup": {
          "description": "Why a purge is not physically cleaned: the free-page residue until a VACUUM, after\n`busy` or the failure findings when a cleanup step did not run through; the revocation\nstands and `kaban doctor --optimize --vacuum` completes the cleanup.",
          "type": [
            "string",
            "null"
          ]
        },
        "governance": {
          "$ref": "#/$defs/Governance",
          "description": "Governance after the call."
        },
        "id": {
          "description": "Node id.",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "description": "Lifecycle after the call."
        },
        "mode": {
          "$ref": "#/$defs/ForgetMode",
          "description": "Mode applied."
        },
        "outbox_seq": {
          "description": "Outbox position of the write (F11).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "physically_cleaned": {
          "description": "The purge's freed pages were reclaimed by this call; the post-commit cleanup (index\nmerged, WAL truncated) reclaims none, so a purge reports `false` with `cleanup` naming\nthe residue. `false` for the other modes.",
          "type": "boolean"
        },
        "receipt": {
          "$ref": "#/$defs/WriteReceipt",
          "description": "The write's receipt (spec 05 SS-10): outcome, store identities and `ChangeLog` position."
        },
        "revoked": {
          "description": "A purge committed: the content is unavailable to every read from now on.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "mode",
        "lifecycle",
        "governance",
        "outbox_seq",
        "revoked",
        "physically_cleaned",
        "receipt"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Index documents"
    },
    "description": "Ingest local documents (Markdown, text) under the given paths of the workspace root into Document, Section and Chunk nodes: deterministic ids, incremental (unchanged files are skipped), every path, title and chunk denylist-gated. Returns the run report (counts only). dry_run counts without writing.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Count and gate without writing.",
          "type": "boolean"
        },
        "include_code": {
          "default": false,
          "description": "Also ingest source-code files as text documents (spec §7; off by default).",
          "type": "boolean"
        },
        "include_forgotten": {
          "default": false,
          "description": "Also re-ingest documents `forget --document` marked forgotten (DI1.8; a path naming\nthe file itself always does).",
          "type": "boolean"
        },
        "link": {
          "description": "Link chunks using `gazetteer`, or disable linking with `none`; absent uses config.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_file_bytes": {
          "description": "Skip files larger than this many bytes (default 2 MiB).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "paths": {
          "description": "Files or directories to ingest; every path must lie inside the workspace root.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "symbols": {
          "default": false,
          "description": "Keep symbol sources and bypass the gazetteer memory cap for this run.",
          "type": "boolean"
        },
        "workers": {
          "description": "Extraction workers (default: the available parallelism).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace": {
          "description": "Workspace to write into (default: the server's bound workspace).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "name": "index_docs",
    "outputSchema": {
      "$defs": {
        "GazetteerTelemetry": {
          "description": "Content-free counters for the run-local gazetteer.",
          "properties": {
            "budget_lifted_by": {
              "description": "The explicit flag that bypassed the cap, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "build_hwm_delta": {
              "description": "Process high-water increase during the build, as a sampling cross-check.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "build_peak_delta": {
              "description": "Sampled process RSS increase while constructing the automaton.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "dropped": {
              "description": "Source names omitted after a budget rebuild.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "memory_usage": {
              "description": "Retained automaton bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "outcome": {
              "description": "Closed outcome: `ok` or `skipped_budget`.",
              "type": "string"
            }
          },
          "required": [
            "memory_usage",
            "build_peak_delta",
            "build_hwm_delta",
            "dropped",
            "outcome"
          ],
          "type": "object"
        },
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). On FTS5 the index is written in the\nmutation's own transaction, so a commit is searchable at once. An index with its own\nstorage (Tantivy, SS-09) publishes behind the commit: the service waits one bounded\nbarrier for the serving reader to cover the receipt's position and otherwise reports the\nthird outcome, which is never a rejection and is never replayed. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            },
            {
              "const": "committed_not_yet_searchable",
              "description": "Committed, and the search index had not incorporated the receipt's position when the\nvisibility barrier expired or failed: the write stands, a later search will show it,\ndo not replay the mutation. CLI status 6.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected`, `committed` or `committed_not_yet_searchable` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "blocked": {
          "description": "Documents recorded `blocked` by the denylist.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "blocked_chunks": {
          "description": "Chunks replaced by a keyed stub.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cancelled": {
          "description": "The run stopped early on cancellation.",
          "type": "boolean"
        },
        "chunks_tombstoned": {
          "description": "Chunks tombstoned because they disappeared.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "chunks_unchanged": {
          "description": "Chunks whose content matched (nothing written).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "chunks_upserted": {
          "description": "Chunks inserted or updated.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "documents": {
          "description": "Documents committed (`ok` or `partial`).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dry_run": {
          "description": "Nothing was written (`dry_run`).",
          "type": "boolean"
        },
        "elapsed_ms": {
          "description": "Wall-clock duration.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "description": "Documents recorded `failed`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gazetteer": {
          "anyOf": [
            {
              "$ref": "#/$defs/GazetteerTelemetry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content-free gazetteer run counters, absent when linking is disabled."
        },
        "outbox_rows": {
          "description": "Outbox rows written.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "partial": {
          "description": "Documents recorded `partial`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/WriteReceipt"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run's receipt (spec 05 SS-10, one barrier per ingest run): `committed` once the\nserving search reader covers the run's rows, `committed_not_yet_searchable` when the\nbarrier expired or failed (the run stands, do not replay it). Absent only from a\nreport the run itself produced before the service settled it."
        },
        "rule_ids": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Denylist rule id -> hits.",
          "type": "object"
        },
        "sections_tombstoned": {
          "default": 0,
          "description": "Sections tombstoned by the diff (DI1.8).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "description": "Candidates skipped (walker rules, unchanged content key).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skipped_forgotten": {
          "default": 0,
          "description": "Forgotten documents a directory or workspace walk left alone (DI1.8; `include_forgotten`\nor naming the file brings them back).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "timed_out": {
          "description": "Documents whose extraction exceeded the per-document deadline.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "workspace": {
          "description": "The workspace the run wrote into (the bound workspace).",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "documents",
        "skipped",
        "failed",
        "blocked",
        "partial",
        "chunks_upserted",
        "chunks_unchanged",
        "chunks_tombstoned",
        "sections_tombstoned",
        "skipped_forgotten",
        "blocked_chunks",
        "outbox_rows",
        "elapsed_ms",
        "cancelled",
        "timed_out",
        "dry_run"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Index status"
    },
    "description": "Status of the document index of the bound workspace: documents by status, chunks, blocked chunks and denylist rule ids (counts only), failed documents with their error, last run, outbox lag, pipeline version and the compiled extractors. Also available as resource kaban://documents with the document list.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    },
    "name": "index_status",
    "outputSchema": {
      "$defs": {
        "FailedDocument": {
          "description": "One failed document of [`IndexStatus`] (docs-ingest-spec D8): the gated path and error.",
          "properties": {
            "error": {
              "description": "The recorded error (one of the pipeline's fixed texts, or a gated extractor message).",
              "type": "string"
            },
            "path": {
              "description": "The gated relative path.",
              "type": "string"
            }
          },
          "required": [
            "path",
            "error"
          ],
          "type": "object"
        },
        "GazetteerTelemetry": {
          "description": "Content-free counters for the run-local gazetteer.",
          "properties": {
            "budget_lifted_by": {
              "description": "The explicit flag that bypassed the cap, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "build_hwm_delta": {
              "description": "Process high-water increase during the build, as a sampling cross-check.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "build_peak_delta": {
              "description": "Sampled process RSS increase while constructing the automaton.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "dropped": {
              "description": "Source names omitted after a budget rebuild.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "memory_usage": {
              "description": "Retained automaton bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "outcome": {
              "description": "Closed outcome: `ok` or `skipped_budget`.",
              "type": "string"
            }
          },
          "required": [
            "memory_usage",
            "build_peak_delta",
            "build_hwm_delta",
            "dropped",
            "outcome"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "blocked_chunks": {
          "description": "Chunks stored as keyed stubs (reject-class hits).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "chunks": {
          "description": "Active chunks over every document.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "documents_by_status": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Active Document nodes by status (`ok`, `partial`, `failed`, `blocked`, `missing`).",
          "type": "object"
        },
        "extractors": {
          "description": "The extractors compiled into this binary (`crate@version`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failed": {
          "description": "Documents recorded `failed`, with their gated error.",
          "items": {
            "$ref": "#/$defs/FailedDocument"
          },
          "type": "array"
        },
        "gazetteer": {
          "anyOf": [
            {
              "$ref": "#/$defs/GazetteerTelemetry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last completed gazetteer run counters, absent when never enabled."
        },
        "last_run": {
          "description": "When the last ingestion run of this workspace finished (RFC 3339), if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "outbox_lag": {
          "description": "Outbox rows not yet acknowledged by every consumer.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pipeline_version": {
          "description": "The pipeline version documents are indexed with.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rule_ids": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Denylist rule id -> hits over every document (counts only).",
          "type": "object"
        },
        "table_unknown_chunks": {
          "description": "Text chunks flagged `table_unknown` over every document (PDF rows that may be a table).\nOmitted when zero.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chunks",
        "blocked_chunks",
        "outbox_lag",
        "pipeline_version"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Ingestion brief"
    },
    "description": "Prepare and place one local document, then publish a workspace-scoped structured extraction brief with an ontology-derived schema and byte-bounded chunk plan. Repeating the same source preserves the original job contract. dry_run previews without persistence; no extractor is executed.",
    "inputSchema": {
      "$defs": {
        "IngestDialect": {
          "description": "Extractor dialect: instructions only, never model execution.",
          "oneOf": [
            {
              "const": "llm",
              "description": "Host-agent / grammar-constrained JSON dialect.",
              "type": "string"
            },
            {
              "const": "gliner",
              "description": "User-owned labeled-span adapter dialect.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "Generic manual instructions.",
              "type": "string"
            }
          ]
        },
        "IngestMode": {
          "description": "One ingestion verb's preparation mode.",
          "oneOf": [
            {
              "const": "plain",
              "description": "Existing document ingestion, without a structured extraction job.",
              "type": "string"
            },
            {
              "const": "structured",
              "description": "Publish a brief for a user-owned extractor.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Preview only, no persistence or pruning.",
          "type": "boolean"
        },
        "link": {
          "default": "none",
          "description": "Explicit linking mode, normally none.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/IngestMode",
          "default": "structured",
          "description": "Preparation mode."
        },
        "path": {
          "description": "Workspace-relative document path; content, never a capability.",
          "type": "string"
        },
        "plan_page": {
          "default": 0,
          "description": "Zero-based byte-bounded chunk-plan page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "symbols": {
          "default": false,
          "description": "Explicit symbol budget override.",
          "type": "boolean"
        },
        "type": {
          "default": null,
          "description": "Optional advisory source type; unknown falls back with a warning.",
          "type": [
            "string",
            "null"
          ]
        },
        "with": {
          "$ref": "#/$defs/IngestDialect",
          "default": "none",
          "description": "External instruction dialect."
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "ingest_brief",
    "outputSchema": {
      "$defs": {
        "AboutCandidate": {
          "additionalProperties": false,
          "description": "Aggregate or document-title match to an existing node, never an automatic ABOUT edge.",
          "properties": {
            "id": {
              "description": "Existing same-workspace target identity.",
              "type": "string"
            },
            "kind": {
              "description": "Loaded target kind; content, not a control.",
              "type": "string"
            },
            "score": {
              "description": "Advisory matcher score, never acceptance evidence.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "id",
            "kind",
            "score"
          ],
          "type": "object"
        },
        "ChunkPlan": {
          "additionalProperties": false,
          "description": "Byte-bounded chunk-plan page; no entry-count-only cap.",
          "properties": {
            "chunks": {
              "description": "Consecutive source-order entries on this page.",
              "items": {
                "$ref": "#/$defs/ChunkRef"
              },
              "type": "array"
            },
            "page": {
              "description": "Zero-based plan page.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pages": {
              "description": "Total plan pages.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "page",
            "pages",
            "chunks"
          ],
          "type": "object"
        },
        "ChunkRef": {
          "additionalProperties": false,
          "description": "Metadata-only entry in a byte-bounded brief plan page.",
          "properties": {
            "byte_end": {
              "description": "Logical source range end.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "byte_start": {
              "description": "Logical source range start.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "Sanitized text byte length, not source range length.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Existing chunk identity.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/IngestChunkKind",
              "description": "Closed chunk kind spelling."
            },
            "n": {
              "description": "Logical source-order number.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "oversize": {
              "description": "Logical chunk exceeds normal target size.",
              "type": "boolean"
            },
            "slices": {
              "description": "Delivery slices after measuring actual serialized bytes.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "token_estimate": {
              "description": "Existing bounded token estimate.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "n",
            "id",
            "kind",
            "bytes",
            "byte_start",
            "byte_end",
            "token_estimate",
            "oversize",
            "slices"
          ],
          "type": "object"
        },
        "HandlingPlan": {
          "additionalProperties": false,
          "description": "Static workflow advice and bounds; document content is always data.",
          "properties": {
            "chunks": {
              "description": "Total logical chunk count.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "deliver": {
              "description": "Incremental delivery instructions.",
              "type": "string"
            },
            "instructions": {
              "description": "Current-policy-gated dialect and governance instructions.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "limits": {
              "$ref": "#/$defs/IngestLimits",
              "description": "Published byte/record ceilings."
            },
            "submit": {
              "description": "Stable-local-id submit instructions.",
              "type": "string"
            }
          },
          "required": [
            "chunks",
            "deliver",
            "submit",
            "limits",
            "instructions"
          ],
          "type": "object"
        },
        "IngestCandidate": {
          "additionalProperties": false,
          "description": "One gated known-entity match, never permission to create an edge.",
          "properties": {
            "ambiguous": {
              "description": "Ambiguous match stays candidate-only.",
              "type": "boolean"
            },
            "byte_end": {
              "description": "Match range end in sanitized text.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "byte_start": {
              "description": "Match range start in sanitized text.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "chunk": {
              "description": "Evidence chunk identity.",
              "type": "string"
            },
            "id": {
              "description": "Existing same-workspace target.",
              "type": "string"
            },
            "kind": {
              "description": "Loaded target kind.",
              "type": "string"
            },
            "method": {
              "description": "Closed core matcher method spelling.",
              "type": "string"
            },
            "score": {
              "description": "Advisory matcher score.",
              "format": "double",
              "type": "number"
            },
            "title": {
              "description": "Sanitized title used only to avoid duplicates.",
              "type": "string"
            }
          },
          "required": [
            "chunk",
            "id",
            "kind",
            "title",
            "method",
            "byte_start",
            "byte_end",
            "score",
            "ambiguous"
          ],
          "type": "object"
        },
        "IngestChunkKind": {
          "description": "One delivered slice of a logical source chunk. Offsets retain the logical source range.",
          "oneOf": [
            {
              "const": "text",
              "description": "Prose.",
              "type": "string"
            },
            {
              "const": "code",
              "description": "Fenced code, preserving one logical chunk.",
              "type": "string"
            },
            {
              "const": "table",
              "description": "Table.",
              "type": "string"
            },
            {
              "const": "stub",
              "description": "Keyed policy stub with no source text.",
              "type": "string"
            }
          ]
        },
        "IngestDialect": {
          "description": "Extractor dialect: instructions only, never model execution.",
          "oneOf": [
            {
              "const": "llm",
              "description": "Host-agent / grammar-constrained JSON dialect.",
              "type": "string"
            },
            {
              "const": "gliner",
              "description": "User-owned labeled-span adapter dialect.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "Generic manual instructions.",
              "type": "string"
            }
          ]
        },
        "IngestDocumentView": {
          "additionalProperties": false,
          "description": "Folded brief document view; no source bytes are persisted with the job.",
          "properties": {
            "content_hash": {
              "description": "Sanitized document content identity.",
              "type": "string"
            },
            "format": {
              "description": "Closed document format spelling.",
              "type": "string"
            },
            "id": {
              "description": "Existing document-ingestion identity.",
              "type": "string"
            },
            "indexed": {
              "description": "True only after actual document/chunk publication has been verified.",
              "type": "boolean"
            },
            "lang": {
              "description": "Sanitized language, or null when absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "Current-policy admitted workspace-relative path.",
              "type": "string"
            },
            "size": {
              "description": "Walked source byte length.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "description": "Sanitized title, or null when absent.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "path",
            "format",
            "size",
            "content_hash",
            "title",
            "lang",
            "indexed"
          ],
          "type": "object"
        },
        "IngestLimits": {
          "additionalProperties": false,
          "description": "Published ingestion bounds, including the full serialized result ceiling.",
          "properties": {
            "props_bytes": {
              "description": "Maximum record props JSON size.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "records_per_submit": {
              "description": "Maximum records in one submit.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "result_bytes": {
              "description": "Maximum complete serialized brief/next response size.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "submit_bytes": {
              "description": "Maximum submitted JSON body size.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "submit_bytes",
            "props_bytes",
            "records_per_submit",
            "result_bytes"
          ],
          "type": "object"
        },
        "IngestMode": {
          "description": "One ingestion verb's preparation mode.",
          "oneOf": [
            {
              "const": "plain",
              "description": "Existing document ingestion, without a structured extraction job.",
              "type": "string"
            },
            {
              "const": "structured",
              "description": "Publish a brief for a user-owned extractor.",
              "type": "string"
            }
          ]
        },
        "IngestNextCall": {
          "additionalProperties": false,
          "description": "Suggested explicit follow-up tool call.",
          "properties": {
            "args": {
              "$ref": "#/$defs/IngestNextRequest",
              "description": "Typed-control-validated follow-up arguments."
            },
            "tool": {
              "description": "Closed ingestion tool name, not an executable.",
              "type": "string"
            }
          },
          "required": [
            "tool",
            "args"
          ],
          "type": "object"
        },
        "IngestNextRequest": {
          "additionalProperties": false,
          "description": "Canonical next request: exactly one of `n` or `chunks` is validated by the handler.",
          "properties": {
            "chunks": {
              "description": "Exclusive-ended logical chunk range in `a..b` spelling.",
              "type": [
                "string",
                "null"
              ]
            },
            "fence": {
              "description": "Monotonic holder proof, required only for claimed jobs.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "job": {
              "description": "Workspace-scoped canonical 64-hex handle.",
              "type": "string"
            },
            "n": {
              "description": "Logical source-order chunk number, mutually exclusive with `chunks`.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "slice": {
              "description": "Zero-based delivery slice; valid only together with `n`.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "job"
          ],
          "type": "object"
        },
        "PairRef": {
          "additionalProperties": false,
          "description": "Exact counterpart of the core ER pair reference.",
          "properties": {
            "a": {
              "description": "First requested node.",
              "type": "string"
            },
            "b": {
              "description": "Second requested node.",
              "type": "string"
            }
          },
          "required": [
            "a",
            "b"
          ],
          "type": "object"
        },
        "TargetSchema": {
          "additionalProperties": false,
          "description": "Ontology-derived extractor contract, frozen in the job envelope.",
          "properties": {
            "allowed_edges": {
              "description": "Explicit ontology-permitted source/relation/target triples.",
              "items": {
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            "governance": {
              "description": "Governed records remain proposed.",
              "type": "string"
            },
            "json_schema": {
              "description": "Canonical extractor schema projected for these kinds."
            },
            "kaban_adds": {
              "description": "Provenance edges added by kaban, never acceptance.",
              "items": {
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
