  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Claim ingestion job"
    },
    "description": "Claim the first available pending document in a bounded workspace-local path-ordered scan. Returns a gated extraction brief and fenced lease, or a null job when idle. External workers carry the fence on next, submit and finish; no extractor or scheduler is executed.",
    "inputSchema": {
      "$defs": {
        "IngestDialect": {
          "description": "Extractor dialect: instructions only, never model execution.",
          "oneOf": [
            {
              "const": "llm",
              "description": "Host-agent / grammar-constrained JSON dialect.",
              "type": "string"
            },
            {
              "const": "gliner",
              "description": "User-owned labeled-span adapter dialect.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "Generic manual instructions.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "path_prefix": {
          "description": "Optional workspace-relative prefix; CONTENT, never a query language.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "Optional source type override.",
          "type": [
            "string",
            "null"
          ]
        },
        "with": {
          "$ref": "#/$defs/IngestDialect",
          "description": "External extractor dialect."
        },
        "worker": {
          "description": "Worker identity; defaults to host:pid.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "with"
      ],
      "type": "object"
    },
    "name": "ingest_claim",
    "outputSchema": {
      "$defs": {
        "AboutCandidate": {
          "additionalProperties": false,
          "description": "Aggregate or document-title match to an existing node, never an automatic ABOUT edge.",
          "properties": {
            "id": {
              "description": "Existing same-workspace target identity.",
              "type": "string"
            },
            "kind": {
              "description": "Loaded target kind; content, not a control.",
              "type": "string"
            },
            "score": {
              "description": "Advisory matcher score, never acceptance evidence.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "id",
            "kind",
            "score"
          ],
          "type": "object"
        },
        "ChunkPlan": {
          "additionalProperties": false,
          "description": "Byte-bounded chunk-plan page; no entry-count-only cap.",
          "properties": {
            "chunks": {
              "description": "Consecutive source-order entries on this page.",
              "items": {
                "$ref": "#/$defs/ChunkRef"
              },
              "type": "array"
            },
            "page": {
              "description": "Zero-based plan page.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pages": {
              "description": "Total plan pages.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "page",
            "pages",
            "chunks"
          ],
          "type": "object"
        },
        "ChunkRef": {
          "additionalProperties": false,
          "description": "Metadata-only entry in a byte-bounded brief plan page.",
          "properties": {
            "byte_end": {
              "description": "Logical source range end.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "byte_start": {
              "description": "Logical source range start.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "bytes": {
              "description": "Sanitized text byte length, not source range length.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "description": "Existing chunk identity.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/IngestChunkKind",
              "description": "Closed chunk kind spelling."
            },
            "n": {
              "description": "Logical source-order number.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "oversize": {
              "description": "Logical chunk exceeds normal target size.",
              "type": "boolean"
            },
            "slices": {
              "description": "Delivery slices after measuring actual serialized bytes.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "token_estimate": {
              "description": "Existing bounded token estimate.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "n",
            "id",
            "kind",
            "bytes",
            "byte_start",
            "byte_end",
            "token_estimate",
            "oversize",
            "slices"
          ],
          "type": "object"
        },
        "HandlingPlan": {
          "additionalProperties": false,
          "description": "Static workflow advice and bounds; document content is always data.",
          "properties": {
            "chunks": {
              "description": "Total logical chunk count.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "deliver": {
              "description": "Incremental delivery instructions.",
              "type": "string"
            },
            "instructions": {
              "description": "Current-policy-gated dialect and governance instructions.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "limits": {
              "$ref": "#/$defs/IngestLimits",
              "description": "Published byte/record ceilings."
            },
            "submit": {
              "description": "Stable-local-id submit instructions.",
              "type": "string"
            }
          },
          "required": [
            "chunks",
            "deliver",
            "submit",
            "limits",
            "instructions"
          ],
          "type": "object"
        },
        "IngestBrief": {
          "additionalProperties": false,
          "description": "Folded §4.1 brief shape; canonical API-owned wire type consumed by the runtime.",
          "properties": {
            "about_candidates": {
              "default": [],
              "description": "Existing candidate identities suitable for explicit about references.",
              "items": {
                "$ref": "#/$defs/AboutCandidate"
              },
              "type": "array"
            },
            "candidates": {
              "default": [],
              "description": "Candidate-only gazetteer matches; structured preparation writes no mention edges.",
              "items": {
                "$ref": "#/$defs/IngestCandidate"
              },
              "type": "array"
            },
            "chunk_plan": {
              "$ref": "#/$defs/ChunkPlan",
              "description": "One byte-bounded logical chunk-plan page."
            },
            "document": {
              "$ref": "#/$defs/IngestDocumentView",
              "description": "Prepared document placement result."
            },
            "extractor_hints": {
              "description": "Dialect-specific labeled-span/grammar guidance, never an execution request."
            },
            "handling_plan": {
              "$ref": "#/$defs/HandlingPlan",
              "description": "Static workflow advice and bounds."
            },
            "job": {
              "description": "Workspace-scoped deterministic handle, not a capability.",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/IngestMode",
              "description": "Requested preparation mode."
            },
            "next": {
              "description": "Suggested explicit continuation tool calls.",
              "items": {
                "$ref": "#/$defs/IngestNextCall"
              },
              "type": "array"
            },
            "suggestion": {
              "$ref": "#/$defs/TypeSuggestion",
              "description": "Advisory type selection."
            },
            "target_schema": {
              "$ref": "#/$defs/TargetSchema",
              "description": "Frozen ontology-derived extractor schema."
            },
            "uncertain_pairs": {
              "default": [],
              "description": "Explicit uncertain pairs, never inferred acceptance.",
              "items": {
                "$ref": "#/$defs/PairRef"
              },
              "type": "array"
            },
            "with": {
              "$ref": "#/$defs/IngestDialect",
              "description": "Explicit extractor instruction dialect."
            }
          },
          "required": [
            "job",
            "mode",
            "with",
            "document",
            "suggestion",
            "target_schema",
            "handling_plan",
            "chunk_plan",
            "extractor_hints",
            "candidates",
            "about_candidates",
            "uncertain_pairs",
            "next"
          ],
          "type": "object"
        },
        "IngestCandidate": {
          "additionalProperties": false,
          "description": "One gated known-entity match, never permission to create an edge.",
          "properties": {
            "ambiguous": {
              "description": "Ambiguous match stays candidate-only.",
              "type": "boolean"
            },
            "byte_end": {
              "description": "Match range end in sanitized text.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "byte_start": {
              "description": "Match range start in sanitized text.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "chunk": {
              "description": "Evidence chunk identity.",
              "type": "string"
            },
            "id": {
              "description": "Existing same-workspace target.",
              "type": "string"
            },
            "kind": {
              "description": "Loaded target kind.",
              "type": "string"
            },
            "method": {
              "description": "Closed core matcher method spelling.",
              "type": "string"
            },
            "score": {
              "description": "Advisory matcher score.",
              "format": "double",
              "type": "number"
            },
            "title": {
              "description": "Sanitized title used only to avoid duplicates.",
              "type": "string"
            }
          },
          "required": [
            "chunk",
            "id",
            "kind",
            "title",
            "method",
            "byte_start",
            "byte_end",
            "score",
            "ambiguous"
          ],
          "type": "object"
        },
        "IngestChunkKind": {
          "description": "One delivered slice of a logical source chunk. Offsets retain the logical source range.",
          "oneOf": [
            {
              "const": "text",
              "description": "Prose.",
              "type": "string"
            },
            {
              "const": "code",
              "description": "Fenced code, preserving one logical chunk.",
              "type": "string"
            },
            {
              "const": "table",
              "description": "Table.",
              "type": "string"
            },
            {
              "const": "stub",
              "description": "Keyed policy stub with no source text.",
              "type": "string"
            }
          ]
        },
        "IngestDialect": {
          "description": "Extractor dialect: instructions only, never model execution.",
          "oneOf": [
            {
              "const": "llm",
              "description": "Host-agent / grammar-constrained JSON dialect.",
              "type": "string"
            },
            {
              "const": "gliner",
              "description": "User-owned labeled-span adapter dialect.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "Generic manual instructions.",
              "type": "string"
            }
          ]
        },
        "IngestDocumentView": {
          "additionalProperties": false,
          "description": "Folded brief document view; no source bytes are persisted with the job.",
          "properties": {
            "content_hash": {
              "description": "Sanitized document content identity.",
              "type": "string"
            },
            "format": {
              "description": "Closed document format spelling.",
              "type": "string"
            },
            "id": {
              "description": "Existing document-ingestion identity.",
              "type": "string"
            },
            "indexed": {
              "description": "True only after actual document/chunk publication has been verified.",
              "type": "boolean"
            },
            "lang": {
              "description": "Sanitized language, or null when absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "Current-policy admitted workspace-relative path.",
              "type": "string"
            },
            "size": {
              "description": "Walked source byte length.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "description": "Sanitized title, or null when absent.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "path",
            "format",
            "size",
            "content_hash",
            "title",
            "lang",
            "indexed"
          ],
          "type": "object"
        },
        "IngestLease": {
          "additionalProperties": false,
          "description": "Live holder proof returned by an atomic claim.",
          "properties": {
            "expires_at": {
              "description": "Lease expiry in database epoch seconds.",
              "format": "int64",
              "type": "integer"
            },
            "fence": {
              "description": "Monotonic fence carried on next, submit and finish.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "fence",
            "expires_at"
          ],
          "type": "object"
        },
        "IngestLimits": {
          "additionalProperties": false,
          "description": "Published ingestion bounds, including the full serialized result ceiling.",
          "properties": {
            "props_bytes": {
              "description": "Maximum record props JSON size.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "records_per_submit": {
              "description": "Maximum records in one submit.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "result_bytes": {
              "description": "Maximum complete serialized brief/next response size.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "submit_bytes": {
              "description": "Maximum submitted JSON body size.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "submit_bytes",
            "props_bytes",
            "records_per_submit",
            "result_bytes"
          ],
          "type": "object"
        },
        "IngestMode": {
          "description": "One ingestion verb's preparation mode.",
          "oneOf": [
            {
              "const": "plain",
              "description": "Existing document ingestion, without a structured extraction job.",
              "type": "string"
            },
            {
              "const": "structured",
              "description": "Publish a brief for a user-owned extractor.",
              "type": "string"
            }
          ]
        },
        "IngestNextCall": {
          "additionalProperties": false,
          "description": "Suggested explicit follow-up tool call.",
          "properties": {
            "args": {
              "$ref": "#/$defs/IngestNextRequest",
              "description": "Typed-control-validated follow-up arguments."
            },
            "tool": {
              "description": "Closed ingestion tool name, not an executable.",
              "type": "string"
            }
          },
          "required": [
            "tool",
            "args"
          ],
          "type": "object"
        },
        "IngestNextRequest": {
          "additionalProperties": false,
          "description": "Canonical next request: exactly one of `n` or `chunks` is validated by the handler.",
          "properties": {
            "chunks": {
              "description": "Exclusive-ended logical chunk range in `a..b` spelling.",
              "type": [
                "string",
                "null"
              ]
            },
            "fence": {
              "description": "Monotonic holder proof, required only for claimed jobs.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "job": {
              "description": "Workspace-scoped canonical 64-hex handle.",
              "type": "string"
            },
            "n": {
              "description": "Logical source-order chunk number, mutually exclusive with `chunks`.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "slice": {
              "description": "Zero-based delivery slice; valid only together with `n`.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "job"
          ],
          "type": "object"
        },
        "PairRef": {
          "additionalProperties": false,
          "description": "Exact counterpart of the core ER pair reference.",
          "properties": {
            "a": {
              "description": "First requested node.",
              "type": "string"
            },
            "b": {
              "description": "Second requested node.",
              "type": "string"
            }
          },
          "required": [
            "a",
            "b"
          ],
          "type": "object"
        },
        "TargetSchema": {
          "additionalProperties": false,
          "description": "Ontology-derived extractor contract, frozen in the job envelope.",
          "properties": {
            "allowed_edges": {
              "description": "Explicit ontology-permitted source/relation/target triples.",
              "items": {
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            "governance": {
              "description": "Governed records remain proposed.",
              "type": "string"
            },
            "json_schema": {
              "description": "Canonical extractor schema projected for these kinds."
            },
            "kaban_adds": {
              "description": "Provenance edges added by kaban, never acceptance.",
              "items": {
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            "kinds": {
              "description": "Enabled allowed kind names from loaded ontology mappings.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "required": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "description": "Required extractor fields per kind, including dotted props names.",
              "type": "object"
            },
            "semantics": {
              "description": "Absence and quotation semantics.",
              "type": "string"
            }
          },
          "required": [
            "kinds",
            "json_schema",
            "required",
            "semantics",
            "allowed_edges",
            "kaban_adds",
            "governance"
          ],
          "type": "object"
        },
        "TypeCandidate": {
          "additionalProperties": false,
          "description": "Advisory source type; never supplies record fields or acceptance evidence.",
          "properties": {
            "confidence": {
              "description": "Bounded heuristic score, not model confidence.",
              "format": "double",
              "type": "number"
            },
            "signals": {
              "description": "Advisory signal descriptions, possibly empty.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "description": "Source-type spelling from the deterministic signal selector.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "confidence",
            "signals"
          ],
          "type": "object"
        },
        "TypeSuggestion": {
          "additionalProperties": false,
          "description": "Source-type selection and advisory candidates.",
          "properties": {
            "candidates": {
              "description": "Source-order independent deterministic candidates.",
              "items": {
                "$ref": "#/$defs/TypeCandidate"
              },
              "type": "array"
            },
            "chosen": {
              "description": "Explicit or suggested source type used for kind selection.",
              "type": "string"
            },
            "note": {
              "description": "Advisory warning/explanation; never an acceptance promise.",
              "type": "string"
            }
          },
          "required": [
            "candidates",
            "chosen",
            "note"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "brief": {
          "anyOf": [
            {
              "$ref": "#/$defs/IngestBrief"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when a lease was acquired."
        },
        "job": {
          "description": "Null when the bounded scan found no available source.",
          "type": [
            "string",
            "null"
          ]
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/IngestLease"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when a lease was acquired."
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Finish ingestion job"
    },
    "description": "Finish a workspace-scoped structured ingestion job: reconcile the union of successful submits, preserve human and foreign edges, and retain a gated canonical report for bounded byte-identical retries. Reopens and revalidates the source and current policy; no extractor is executed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "fence": {
          "description": "Monotonic holder proof, required only for claimed jobs.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "job": {
          "description": "Persistent ingestion handle.",
          "type": "string"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "name": "ingest_finish",
    "outputSchema": {
      "$defs": {
        "IngestChanges": {
          "additionalProperties": false,
          "description": "Actual graph `ChangeLog` sequence range of publication.",
          "properties": {
            "first_seq": {
              "description": "First sequence, absent for a graph no-op.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "last_seq": {
              "description": "Last sequence, absent for a graph no-op.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "first_seq",
            "last_seq"
          ],
          "type": "object"
        },
        "IngestReconcileOutcome": {
          "description": "Complete reconciliation or a fail-safe refusal to delete beyond the cap.",
          "oneOf": [
            {
              "const": "complete",
              "description": "Complete scoped population reconciled.",
              "type": "string"
            },
            {
              "const": "skipped_cap",
              "description": "Complete population exceeded its bound; no retirement or deletion occurred.",
              "type": "string"
            }
          ]
        },
        "IngestReportStatus": {
          "description": "Closed persistent job status on report responses.",
          "oneOf": [
            {
              "const": "open",
              "description": "Further submits remain possible.",
              "type": "string"
            },
            {
              "const": "finished",
              "description": "Final report is frozen.",
              "type": "string"
            },
            {
              "const": "stale",
              "description": "Original source or ontology contract changed.",
              "type": "string"
            },
            {
              "const": "expired",
              "description": "Job reached its bounded expiry.",
              "type": "string"
            }
          ]
        },
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). On FTS5 the index is written in the\nmutation's own transaction, so a commit is searchable at once. An index with its own\nstorage (Tantivy, SS-09) publishes behind the commit: the service waits one bounded\nbarrier for the serving reader to cover the receipt's position and otherwise reports the\nthird outcome, which is never a rejection and is never replayed. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            },
            {
              "const": "committed_not_yet_searchable",
              "description": "Committed, and the search index had not incorporated the receipt's position when the\nvisibility barrier expired or failed: the write stands, a later search will show it,\ndo not replay the mutation. CLI status 6.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected`, `committed` or `committed_not_yet_searchable` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "description": "Accumulated newly inserted assertions.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "changes": {
          "$ref": "#/$defs/IngestChanges",
          "description": "Actual first/last graph sequence across successful submits and reconciliation."
        },
        "created": {
          "description": "Accumulated created records.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "deleted_edges": {
          "description": "Omitted owned graph edges deleted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "edges": {
          "description": "Accumulated named edges.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "evidence_dropped": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Fixed discarded evidence reasons and counts.",
          "type": "object"
        },
        "job": {
          "description": "Persistent scoped handle.",
          "type": "string"
        },
        "orphans": {
          "description": "Proposed omitted records; informational, never tombstoned.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "predecessor_terminal": {
          "description": "Revisions of terminal predecessors.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/WriteReceipt"
            },
            {
              "type": "null"
            }
          ],
          "description": "The finish's receipt (spec 05 SS-10), with `changes.last_seq` as its position; absent\nonly on a report retained before receipts existed."
        },
        "reconcile": {
          "$ref": "#/$defs/IngestReconcileOutcome",
          "description": "Final reconciliation outcome."
        },
        "redactions": {
          "description": "Accumulated successful redactions.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retired_assertions": {
          "description": "Machine claims permanently retired.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revision_candidates": {
          "description": "Proposed revisions, never acceptance.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Fixed skip reasons and counts.",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/IngestReportStatus",
          "description": "Always finished on success."
        },
        "submits": {
          "description": "Successful submit count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unchanged": {
          "description": "Accumulated unchanged records.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "updated": {
          "description": "Accumulated updated records.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "job",
        "status",
        "submits",
        "created",
        "updated",
        "unchanged",
        "redactions",
        "edges",
        "assertions",
        "revision_candidates",
        "predecessor_terminal",
        "skipped",
        "evidence_dropped",
        "reconcile",
        "retired_assertions",
        "deleted_edges",
        "orphans",
        "changes"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Next ingestion chunk"
    },
    "description": "Reopen and revalidate a structured ingestion job source, then deliver one chunk slice or a serialized-byte-bounded range of whole chunks. Workspace scoped; no cache or extractor execution. Content or ontology edits make the job stale.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "description": "Exclusive-ended logical chunk range in `a..b` spelling.",
          "type": [
            "string",
            "null"
          ]
        },
        "fence": {
          "description": "Monotonic holder proof, required only for claimed jobs.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "job": {
          "description": "Workspace-scoped canonical 64-hex handle.",
          "type": "string"
        },
        "n": {
          "description": "Logical source-order chunk number, mutually exclusive with `chunks`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "slice": {
          "description": "Zero-based delivery slice; valid only together with `n`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "name": "ingest_next",
    "outputSchema": {
      "$defs": {
        "ChunkContinuation": {
          "additionalProperties": false,
          "description": "Resume position, or null when the requested document portion is exhausted.",
          "properties": {
            "n": {
              "description": "Logical chunk number.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "slice": {
              "description": "Zero-based delivery slice number.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "n",
            "slice"
          ],
          "type": "object"
        },
        "ChunkView": {
          "additionalProperties": false,
          "description": "One delivered slice of a logical source chunk. Offsets retain the logical source range.",
          "properties": {
            "byte_end": {
              "description": "Exclusive logical chunk end in the extracted source, unchanged across slices.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "byte_start": {
              "description": "Inclusive logical chunk start in the extracted source, unchanged across slices.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "context_prefix": {
              "description": "Sanitized explanatory prefix; not included in text offsets.",
              "type": "string"
            },
            "id": {
              "description": "Existing document-ingestion chunk identity.",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/IngestChunkKind",
              "description": "Closed document-ingestion chunk kind."
            },
            "n": {
              "description": "Source-order logical chunk number.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "section_path": {
              "description": "Sanitized heading path.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "slice": {
              "description": "Zero-based delivery slice number.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "slices": {
              "description": "Number of delivery slices in this logical chunk.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "description": "Exact UTF-8 slice of the sanitized chunk text.",
              "type": "string"
            }
          },
          "required": [
            "n",
            "id",
            "kind",
            "section_path",
            "context_prefix",
            "text",
            "byte_start",
            "byte_end",
            "slice",
            "slices"
          ],
          "type": "object"
        },
        "IngestChunkKind": {
          "description": "One delivered slice of a logical source chunk. Offsets retain the logical source range.",
          "oneOf": [
            {
              "const": "text",
              "description": "Prose.",
              "type": "string"
            },
            {
              "const": "code",
              "description": "Fenced code, preserving one logical chunk.",
              "type": "string"
            },
            {
              "const": "table",
              "description": "Table.",
              "type": "string"
            },
            {
              "const": "stub",
              "description": "Keyed policy stub with no source text.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "chunk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChunkView"
            },
            {
              "type": "null"
            }
          ],
          "description": "Single-chunk delivery slice."
        },
        "chunks": {
          "description": "Consecutive whole chunks in range mode.",
          "items": {
            "$ref": "#/$defs/ChunkView"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "job": {
          "description": "Workspace-scoped handle.",
          "type": "string"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChunkContinuation"
            },
            {
              "type": "null"
            }
          ],
          "description": "First not-yet-delivered position, or null on completion."
        }
      },
      "required": [
        "job",
        "next"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Submit ingestion records"
    },
    "description": "Validate a workspace-scoped structured extractor return against its checked source and pinned ontology, then atomically publish proposed records, acceptance-safe revision candidates, L3 assertions, owned edges, successful audit and bounded job accumulation. No extractor is executed; governed relationships and foreign targets are refused.",
    "inputSchema": {
      "$defs": {
        "EdgeDraft": {
          "additionalProperties": false,
          "description": "Record edge: exactly one destination selector is required by runtime validation.",
          "properties": {
            "from_local_id": {
              "description": "Local record source key in this submit.",
              "type": "string"
            },
            "rel": {
              "description": "Ontology-permitted relationship; never automatic acceptance.",
              "type": "string"
            },
            "to_id": {
              "description": "Workspace-resolved existing node, mutually exclusive with `to_local_id`.",
              "type": [
                "string",
                "null"
              ]
            },
            "to_local_id": {
              "description": "Destination local record key, mutually exclusive with `to_id`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "from_local_id",
            "rel"
          ],
          "type": "object"
        },
        "EvidenceRef": {
          "additionalProperties": false,
          "description": "One quote from a chunk in this job; gates and membership checks precede publication.",
          "properties": {
            "chunk_id": {
              "description": "Job-plan chunk node id.",
              "type": "string"
            },
            "quote": {
              "description": "Verbatim text, never persisted in the job registry.",
              "type": "string"
            }
          },
          "required": [
            "chunk_id",
            "quote"
          ],
          "type": "object"
        },
        "LinkDraft": {
          "additionalProperties": false,
          "description": "Existing-node subset of `EdgeDraft`, for AM-3 candidate reuse.",
          "properties": {
            "from_local_id": {
              "description": "Local record source key.",
              "type": "string"
            },
            "rel": {
              "description": "Ontology-permitted relationship.",
              "type": "string"
            },
            "to_id": {
              "description": "Existing candidate node id; resolves only in the job workspace.",
              "type": "string"
            }
          },
          "required": [
            "from_local_id",
            "rel",
            "to_id"
          ],
          "type": "object"
        },
        "PairJudgement": {
          "additionalProperties": false,
          "description": "Exact counterpart of core ER judgement; no invented confidence or authority.",
          "properties": {
            "pair": {
              "$ref": "#/$defs/PairRef",
              "description": "Pair requested by this brief."
            },
            "same": {
              "description": "Whether the external judge considers it one entity.",
              "type": "boolean"
            }
          },
          "required": [
            "pair",
            "same"
          ],
          "type": "object"
        },
        "PairRef": {
          "additionalProperties": false,
          "description": "Exact counterpart of the core ER pair reference.",
          "properties": {
            "a": {
              "description": "First requested node.",
              "type": "string"
            },
            "b": {
              "description": "Second requested node.",
              "type": "string"
            }
          },
          "required": [
            "a",
            "b"
          ],
          "type": "object"
        },
        "RecordDraft": {
          "additionalProperties": false,
          "description": "Folded §4.1 record payload. No synthesized title or identity field.",
          "properties": {
            "confidence": {
              "description": "Optional confidence, never acceptance evidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "evidence": {
              "default": [],
              "description": "Optional direct quotes from job chunks.",
              "items": {
                "$ref": "#/$defs/EvidenceRef"
              },
              "type": "array"
            },
            "kind": {
              "description": "One allowed kind in the brief's ontology snapshot.",
              "type": "string"
            },
            "local_id": {
              "description": "Stable extractor-local key, 1..128 trimmed characters.",
              "type": "string"
            },
            "path_scope": {
              "default": [],
              "description": "Optional source-supported path globs.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "props": {
              "description": "Ontology-restricted properties, with all internal properties excluded."
            },
            "summary": {
              "description": "Optional summary; absent means absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "symbols": {
              "default": [],
              "description": "Optional existing symbol references; never discovered by executing an extractor.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tags": {
              "default": [],
              "description": "Optional source-supported tags.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "description": "Required nonempty record text, independently gated before placement.",
              "type": "string"
            }
          },
          "required": [
            "local_id",
            "kind",
            "text"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "about": {
          "default": [],
          "description": "Existing candidate node ids, not new records.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "chunk": {
          "description": "Optional source chunk number.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "edges": {
          "default": [],
          "description": "Record-to-record or existing-node relationships.",
          "items": {
            "$ref": "#/$defs/EdgeDraft"
          },
          "type": "array"
        },
        "fence": {
          "description": "Monotonic holder proof, required only for claimed jobs.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "job": {
          "description": "Workspace-scoped deterministic handle; never a capability.",
          "type": "string"
        },
        "links": {
          "default": [],
          "description": "AM-3 links to existing candidates.",
          "items": {
            "$ref": "#/$defs/LinkDraft"
          },
          "type": "array"
        },
        "pair_judgements": {
          "default": [],
          "description": "External pair judgements, normal-rank only; requested pairs only.",
          "items": {
            "$ref": "#/$defs/PairJudgement"
          },
          "type": "array"
        },
        "records": {
          "default": [],
          "description": "Records supported by the source text.",
          "items": {
            "$ref": "#/$defs/RecordDraft"
          },
          "type": "array"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "name": "ingest_submit",
    "outputSchema": {
      "$defs": {
        "IngestChanges": {
          "additionalProperties": false,
          "description": "Actual graph `ChangeLog` sequence range of publication.",
          "properties": {
            "first_seq": {
              "description": "First sequence, absent for a graph no-op.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "last_seq": {
              "description": "Last sequence, absent for a graph no-op.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "first_seq",
            "last_seq"
          ],
          "type": "object"
        },
        "IngestEvidenceDropped": {
          "additionalProperties": false,
          "description": "One discarded evidence reference.",
          "properties": {
            "local_id": {
              "description": "Gated local record key.",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/IngestEvidenceReason",
              "description": "Fixed evidence refusal."
            }
          },
          "required": [
            "local_id",
            "reason"
          ],
          "type": "object"
        },
        "IngestEvidenceReason": {
          "description": "Closed evidence drop vocabulary; invalid evidence does not discard the record.",
          "oneOf": [
            {
              "const": "chunk_not_in_job",
              "description": "Chunk not in the complete scoped job plan.",
              "type": "string"
            },
            {
              "const": "quote_not_found",
              "description": "Quote absent from the current sanitized chunk.",
              "type": "string"
            }
          ]
        },
        "IngestPlacedRecord": {
          "additionalProperties": false,
          "description": "One successfully committed record.",
          "properties": {
            "id": {
              "description": "Committed record identity.",
              "type": "string"
            },
            "local_id": {
              "description": "Gated extractor-local key, not stored in accumulation.",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/IngestRecordOutcome",
              "description": "Actual placement result."
            }
          },
          "required": [
            "local_id",
            "id",
            "outcome"
          ],
          "type": "object"
        },
        "IngestRecordOutcome": {
          "description": "Fixed placement outcomes; governed revisions are candidates, never acceptance.",
          "oneOf": [
            {
              "const": "created",
              "description": "A new record was committed.",
              "type": "string"
            },
            {
              "const": "updated",
              "description": "Proposed record content changed.",
              "type": "string"
            },
            {
              "const": "unchanged",
              "description": "Identical content wrote no graph change.",
              "type": "string"
            },
            {
              "const": "revision_candidate",
              "description": "New proposed content for an immutable predecessor.",
              "type": "string"
            }
          ]
        },
        "IngestReportStatus": {
          "description": "Closed persistent job status on report responses.",
          "oneOf": [
            {
              "const": "open",
              "description": "Further submits remain possible.",
              "type": "string"
            },
            {
              "const": "finished",
              "description": "Final report is frozen.",
              "type": "string"
            },
            {
              "const": "stale",
              "description": "Original source or ontology contract changed.",
              "type": "string"
            },
            {
              "const": "expired",
              "description": "Job reached its bounded expiry.",
              "type": "string"
            }
          ]
        },
        "IngestRevisionCandidate": {
          "additionalProperties": false,
          "description": "Acceptance-safe candidate and its immutable predecessor.",
          "properties": {
            "id": {
              "description": "New proposed record identity.",
              "type": "string"
            },
            "local_id": {
              "description": "Gated extractor-local key.",
              "type": "string"
            },
            "of": {
              "description": "Accepted, superseded or invalidated predecessor identity.",
              "type": "string"
            }
          },
          "required": [
            "local_id",
            "id",
            "of"
          ],
          "type": "object"
        },
        "IngestSkipReason": {
          "description": "Closed report skip vocabulary. References never convey foreign target information.",
          "oneOf": [
            {
              "const": "invalid_props",
              "description": "Invalid non-internal properties or a required field.",
              "type": "string"
            },
            {
              "const": "kind_not_allowed",
              "description": "Kind outside the pinned source schema.",
              "type": "string"
            },
            {
              "const": "edge_not_allowed",
              "description": "Forbidden or incompatible relationship.",
              "type": "string"
            },
            {
              "const": "duplicate_local_id",
              "description": "Both occurrences of a duplicate local key are skipped.",
              "type": "string"
            },
            {
              "const": "hidden_exists",
              "description": "An existing hidden identity cannot be revived.",
              "type": "string"
            },
            {
              "const": "kind_mismatch",
              "description": "An existing identity has another kind.",
              "type": "string"
            },
            {
              "const": "unknown_ref",
              "description": "A local reference is absent or ambiguous.",
              "type": "string"
            },
            {
              "const": "unknown_target",
              "description": "Foreign, missing and hidden external targets share this reason.",
              "type": "string"
            },
            {
              "const": "too_large",
              "description": "Payload exceeds its ceiling.",
              "type": "string"
            },
            {
              "const": "not_requested",
              "description": "Pair was not requested by the authoritative brief.",
              "type": "string"
            },
            {
              "const": "duplicate",
              "description": "Duplicate requested pair judgement.",
              "type": "string"
            }
          ]
        },
        "IngestSkipped": {
          "additionalProperties": false,
          "description": "One fixed conversion refusal, with an optional value-free property pointer.",
          "properties": {
            "field": {
              "description": "Fixed field or ontology-validator pointer; never a caller value.",
              "type": [
                "string",
                "null"
              ]
            },
            "local_id": {
              "description": "Gated local reference, empty for a non-record item.",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/IngestSkipReason",
              "description": "Fixed reason."
            }
          },
          "required": [
            "local_id",
            "reason"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "description": "Actual newly inserted assertion rows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "changes": {
          "$ref": "#/$defs/IngestChanges",
          "description": "Actual graph sequence range."
        },
        "chunk": {
          "description": "Optional caller chunk selector.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "created": {
          "description": "Actual new records.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "edges": {
          "description": "Successfully named edge triples.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "evidence_dropped": {
          "description": "Evidence references discarded independently of record placement.",
          "items": {
            "$ref": "#/$defs/IngestEvidenceDropped"
          },
          "type": "array"
        },
        "job": {
          "description": "Workspace-scoped persistent job handle.",
          "type": "string"
        },
        "predecessor_terminal": {
          "description": "Candidates whose predecessor was superseded or invalidated.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "records": {
          "description": "Committed records and actual outcomes.",
          "items": {
            "$ref": "#/$defs/IngestPlacedRecord"
          },
          "type": "array"
        },
        "redactions": {
          "description": "Successful redactions audited atomically with this submit.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revision_candidates": {
          "description": "Proposed revisions of immutable predecessors.",
          "items": {
            "$ref": "#/$defs/IngestRevisionCandidate"
          },
          "type": "array"
        },
        "skipped": {
          "description": "Fixed conversion refusals.",
          "items": {
            "$ref": "#/$defs/IngestSkipped"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/IngestReportStatus",
          "description": "Persistent job status."
        },
        "unchanged": {
          "description": "Actual unchanged records.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "updated": {
          "description": "Actual changed records.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "job",
        "status",
        "chunk",
        "records",
        "revision_candidates",
        "predecessor_terminal",
        "skipped",
        "evidence_dropped",
        "redactions",
        "created",
        "updated",
        "unchanged",
        "edges",
        "assertions",
        "changes"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Link"
    },
    "description": "Create a typed relationship between two existing nodes. The relationship type must be registered (see schema_describe / schema_extend). Re-linking the same (from, rel, to) updates confidence/props. SUPERSEDES/INVALIDATES mark the target node accordingly.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confidence": {
          "description": "0..1 confidence.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "from": {
          "description": "Source node id.",
          "type": "string"
        },
        "props": {
          "description": "Arbitrary JSON properties (scanned by the denylist)."
        },
        "rel": {
          "description": "Relationship type (must be registered).",
          "type": "string"
        },
        "to": {
          "description": "Destination node id.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "rel",
        "to"
      ],
      "type": "object"
    },
    "name": "link",
    "outputSchema": {
      "$defs": {
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). On FTS5 the index is written in the\nmutation's own transaction, so a commit is searchable at once. An index with its own\nstorage (Tantivy, SS-09) publishes behind the commit: the service waits one bounded\nbarrier for the serving reader to cover the receipt's position and otherwise reports the\nthird outcome, which is never a rejection and is never replayed. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            },
            {
              "const": "committed_not_yet_searchable",
              "description": "Committed, and the search index had not incorporated the receipt's position when the\nvisibility barrier expired or failed: the write stands, a later search will show it,\ndo not replay the mutation. CLI status 6.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected`, `committed` or `committed_not_yet_searchable` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confidence": {
          "description": "0..1 confidence.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "from": {
          "description": "Source node id.",
          "type": "string"
        },
        "id": {
          "description": "Edge id.",
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/WriteReceipt",
          "description": "The write's receipt (spec 05 SS-10): outcome, store identities and `ChangeLog` position."
        },
        "redactions": {
          "description": "`field:rule` entries for every redaction applied.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rel": {
          "description": "Relationship type.",
          "type": "string"
        },
        "to": {
          "description": "Destination node id.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "rel",
        "to",
        "confidence",
        "redactions",
        "receipt"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Recall"
    },
    "description": "Hybrid recall: BM25 full-text search over text/summary/tags plus 1-2 hop graph expansion along typed edges, fused with reciprocal rank fusion and weighted by confidence. Returns compact cards (id, kind, summary, why, score). Use full_text=true to get bodies and props.",
    "inputSchema": {
      "$defs": {
        "CodeRefFilter": {
          "description": "\"About this `CodeRef`\" filter of a recall (core-spec F3; M3-12): exact match on the stored\n`CodeRef` props; an absent optional field matches any value.",
          "properties": {
            "name_path": {
              "description": "Serena-style symbol path (`Class/method`).",
              "type": [
                "string",
                "null"
              ]
            },
            "relative_path": {
              "description": "Path relative to the repository root (as stored: backslashes normalised to `/`).",
              "type": "string"
            },
            "repo": {
              "description": "Repository identity.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "relative_path"
          ],
          "type": "object"
        },
        "RecallLayer": {
          "description": "Recall sources, distinct from assertion producer layers.",
          "oneOf": [
            {
              "const": "fts",
              "description": "Lexical full-text retrieval.",
              "type": "string"
            },
            {
              "const": "fuzzy",
              "description": "Fuzzy (typo-tolerant) retrieval by the text index (spec 05 OWN-M: `fuzzy` on the wire).",
              "type": "string"
            },
            {
              "const": "sim",
              "description": "Reserved similarity retrieval, unavailable in this release.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "enrich": {
          "description": "Enrichers to run on the `CodeRef` pointers of the result (core-spec F19). An id this\nprocess has not configured is an error listing the configured ones; none ships in v3.0.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "full_text": {
          "default": false,
          "description": "Return full text instead of summaries.",
          "type": "boolean"
        },
        "fuzzy": {
          "default": false,
          "description": "Also retrieve fuzzy matches when lexical retrieval succeeds.",
          "type": "boolean"
        },
        "hops": {
          "description": "Graph expansion hops 0..2 (default 1).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "include_archived": {
          "default": false,
          "description": "Also return archived records of any governance reached through graph expansion.",
          "type": "boolean"
        },
        "include_candidates": {
          "default": false,
          "description": "Also return candidate records (an `x:` record still under review, a record a\nreconciliation left for review); default false: a candidate neither seeds the result\nnor joins it through graph expansion. `kaban review` and `explain` list them either way.",
          "type": "boolean"
        },
        "include_superseded": {
          "default": false,
          "description": "Also return superseded (archived) records reached through graph expansion. Invalidated\nand tombstoned records never return.",
          "type": "boolean"
        },
        "kinds": {
          "default": [],
          "description": "Restrict to these kinds.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "layers": {
          "description": "Retrieval sources (fts, fuzzy, reserved sim); absent uses enabled defaults.",
          "items": {
            "$ref": "#/$defs/RecallLayer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "limit": {
          "description": "Max results (default 10, max 100).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "description": "Free-text query (keywords, identifiers, error strings).",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeRefFilter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only notes about this `CodeRef` (linked `ABOUT` or `EVIDENCE_FOR`; exact match on\n`relative_path`, and on `name_path` / `repo` when given) seed the recall."
        },
        "tags": {
          "default": [],
          "description": "Require at least one of these tags.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace_id": {
          "description": "Workspace to search (default: the server's bound workspace; `\"*\"` for all). `workspace`\nis accepted as an alias.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "recall",
    "outputSchema": {
      "$defs": {
        "BodyLocation": {
          "additionalProperties": false,
          "description": "A symbol body span as Serena emits it (core-spec §6).",
          "properties": {
            "end_line": {
              "description": "Last line of the body.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "description": "First line of the body.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "end_line"
          ],
          "type": "object"
        },
        "Card": {
          "description": "Outgoing projection of a node (re-scanned on read when the policy says so).",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "created_at": {
              "description": "Creation time (RFC 3339).",
              "type": "string"
            },
            "governance": {
              "$ref": "#/$defs/Governance",
              "description": "Governance state (`none` for kinds other than Decision, Convention and Failure)."
            },
            "id": {
              "description": "Node id.",
              "type": "string"
            },
            "kind": {
              "description": "Node kind.",
              "type": "string"
            },
            "lifecycle": {
              "$ref": "#/$defs/Lifecycle",
              "description": "Storage visibility (`active` unless the read opted into archived records)."
            },
            "props": {
              "description": "Props (full text only, omitted when empty)."
            },
            "provenance": {
              "$ref": "#/$defs/Provenance",
              "default": {
                "store": "project"
              },
              "description": "Who produced the record and where it lives."
            },
            "redactions": {
              "description": "`field:rule` entries for redactions applied on read (omitted when none).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "score": {
              "description": "Fused score (recall only), rounded to 3 decimals.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "summary": {
              "description": "Summary, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "description": "Tags (omitted when empty).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "description": "Text (present when full text was requested or the node has no summary).",
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "description": "Why the card was returned (recall only).",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "workspace_id": {
              "description": "Workspace id (every row carries one, F17).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "lifecycle",
            "governance",
            "created_at",
            "workspace_id",
            "provenance"
          ],
          "type": "object"
        },
        "CodeRef": {
          "description": "The stored form of a code reference (the props of a `CodeRef` node; core-spec §4, §6): the\nwire fields minus `info`, plus the derived `line` (`location.line`, else\n`body_location.start_line`). Every string has passed the denylist gate.",
          "properties": {
            "body_location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BodyLocation"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Body span, when known."
            },
            "commit": {
              "description": "Commit the reference was taken at.",
              "type": "string"
            },
            "kind": {
              "description": "`SymbolKind` enum name (`\"Class\"`, `\"Function\"`, ...).",
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "description": "Derived line: `location.line`, else `body_location.start_line`.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Location"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Position, when known (0-based)."
            },
            "name_path": {
              "description": "Serena-style symbol path (`Class/method`, `[i]` overload suffix kept).",
              "type": [
                "string",
                "null"
              ]
            },
            "observed_at": {
              "description": "When the reference was observed, RFC 3339 (stage1-spec §4.4): set by `remember` when\nthe request carries none.",
              "type": [
                "string",
                "null"
              ]
            },
            "reference_line": {
              "description": "Line of a reference site (0-based), when known.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "relative_path": {
              "description": "Path relative to the repository root, `/`-separated.",
              "type": "string"
            },
            "repo": {
              "description": "Repository identity.",
              "type": "string"
            },
            "snapshot_commit": {
              "description": "The 40-hex commit of the snapshot `symbol` was taken from or verified against (SO-2;\nG1-F9): a short request value is canonicalised before it is stored.",
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "description": "The normalised SCIP symbol key (stage1-spec G1-F9; cg-join-v1 §5): grammar-checked\nafter the content scan, stored in its normalised form; derived from `relative_path` and\n`name_path` through the resolved snapshot when absent. `name_path` is never a key.",
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "description": "Tool of origin (`serena`, `manual`, `kaban-adr`).",
              "type": "string"
            }
          },
          "required": [
            "repo",
            "commit",
            "tool",
            "relative_path"
          ],
          "type": "object"
        },
        "Enrichment": {
          "description": "One piece of enrichment about a `CodeRef` (every string is content, gated on read).",
          "properties": {
            "enricher": {
              "description": "Id of the enricher that produced it.",
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/CodeRef",
              "description": "The pointer it is about."
            },
            "text": {
              "description": "The enrichment text.",
              "type": "string"
            }
          },
          "required": [
            "enricher",
            "ref",
            "text"
          ],
          "type": "object"
        },
        "FollowUp": {
          "description": "A suggestion the agent may execute with another tool (core-spec F19). kaban never runs it.",
          "properties": {
            "args": {
              "description": "Arguments for that tool, built from the masked `CodeRef` props."
            },
            "reason": {
              "description": "Why the suggestion is made (names the pointer, never a node id).",
              "type": "string"
            },
            "tool": {
              "$ref": "#/$defs/FollowUpTool",
              "description": "The tool to call."
            }
          },
          "required": [
            "tool",
            "args",
            "reason"
          ],
          "type": "object"
        },
        "FollowUpTool": {
          "description": "Tools a follow-up may name (closed set; the wire form is the dotted tool name).",
          "oneOf": [
            {
              "const": "serena.find_symbol",
              "description": "Serena `find_symbol` (`name_path` + `relative_path`).",
              "type": "string"
            },
            {
              "const": "serena.find_referencing_symbols",
              "description": "Serena `find_referencing_symbols` (`name_path` + `relative_path`).",
              "type": "string"
            }
          ]
        },
        "Governance": {
          "description": "Governance state of a `Decision`, `Convention` or `Failure`; [`Governance::None`] for every\nother kind.",
          "oneOf": [
            {
              "const": "none",
              "description": "The kind is not governed.",
              "type": "string"
            },
            {
              "const": "proposed",
              "description": "Recorded, not yet accepted (ranked below accepted in `why`).",
              "type": "string"
            },
            {
              "const": "accepted",
              "description": "Accepted with reason and path scope (event recorded).",
              "type": "string"
            },
            {
              "const": "superseded",
              "description": "Replaced by a newer record (`SUPERSEDES` edge plus event).",
              "type": "string"
            },
            {
              "const": "invalidated",
              "description": "Declared no longer valid (event recorded).",
              "type": "string"
            }
          ]
        },
        "Lifecycle": {
          "description": "Storage visibility of a node. Reads default to [`Lifecycle::Active`].",
          "oneOf": [
            {
              "const": "active",
              "description": "Visible to recall, traverse and get.",
              "type": "string"
            },
            {
              "const": "archived",
              "description": "Kept and reachable through graph expansion or `include_archived`; not in the text index.",
              "type": "string"
            },
            {
              "const": "tombstoned",
              "description": "Hidden everywhere; never re-proposed as a duplicate. Terminal except for purge.",
              "type": "string"
            },
            {
              "const": "purged",
              "description": "Text, index entries and edges removed; only the id row remains so it never reappears.",
              "type": "string"
            }
          ]
        },
        "Location": {
          "additionalProperties": false,
          "description": "A position as Serena emits it (0-based line and column; core-spec §6).",
          "properties": {
            "column": {
              "description": "0-based column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line": {
              "description": "0-based line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "line",
            "column"
          ],
          "type": "object"
        },
        "Provenance": {
          "description": "Where a card came from (core-spec F3 \"cards with provenance\"; core-plan C3.5). Every string\nis a persisted node string, masked by the read projection like the rest of the card.",
          "properties": {
            "agent_id": {
              "description": "Agent that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "commit_sha": {
              "description": "Commit the record was taken at, when stamped.",
              "type": [
                "string",
                "null"
              ]
            },
            "repo": {
              "description": "Repository identity (the root directory name, M3-23).",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "description": "Session that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "store": {
              "$ref": "#/$defs/StoreScope",
              "description": "Which store the record lives in (`project`; `personal` arrives in M6)."
            }
          },
          "required": [
            "store"
          ],
          "type": "object"
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "Number of cards.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "enrichments": {
          "description": "Output of the enrichers named in `enrich[]` (omitted when none ran or produced nothing).",
          "items": {
            "$ref": "#/$defs/Enrichment"
          },
          "type": "array"
        },
        "follow_ups": {
          "default": [],
          "description": "Suggestions the agent may run with other tools, derived from the `CodeRef` pointers\nlinked to the cards of this result (core-spec F19); kaban never executes them.",
          "items": {
            "$ref": "#/$defs/FollowUp"
          },
          "type": "array"
        },
        "results": {
          "description": "Cards, best first.",
          "items": {
            "$ref": "#/$defs/Card"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "results",
        "follow_ups"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Remember"
    },
    "description": "Store a memory node (Fact, Idea, Failure, Improvement, Decision, Insight, Entity, Episode or a registered custom kind). Every field is scanned by the denylist first; sensitive content is rejected (nothing stored) or redacted. Exact duplicates return the existing node. Links are created atomically with the node.",
    "inputSchema": {
      "$defs": {
        "BodyLocation": {
          "additionalProperties": false,
          "description": "A symbol body span as Serena emits it (core-spec §6).",
          "properties": {
            "end_line": {
              "description": "Last line of the body.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "description": "First line of the body.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "end_line"
          ],
          "type": "object"
        },
        "CodeRefWire": {
          "additionalProperties": false,
          "description": "A code reference on the wire, exactly as core-spec §6 defines it (Serena field names;\nnested `location` and `body_location`, never a flat `line`). `info` is scanned by the\ndenylist and then dropped; `body`, `content_around_reference` and `children` are not accepted\nhere (the Serena adapter drops them before anything else).",
          "properties": {
            "body_location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BodyLocation"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Body span `{start_line, end_line}`."
            },
            "commit": {
              "description": "Commit the reference was taken at.",
              "type": "string"
            },
            "info": {
              "description": "Free text about the symbol: scanned, never stored.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "description": "`SymbolKind` enum name, e.g. `\"Function\"`.",
              "type": [
                "string",
                "null"
              ]
            },
            "location": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Location"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Position `{line, column}`, 0-based."
            },
            "name_path": {
              "description": "Serena-style symbol path (`Class/method`; the `[i]` overload suffix is kept).",
              "type": [
                "string",
                "null"
              ]
            },
            "observed_at": {
              "description": "When the reference was observed, RFC 3339 (stage1-spec §4.4); `remember` sets it when\nabsent.",
              "type": [
                "string",
                "null"
              ]
            },
            "reference_line": {
              "description": "Line of a reference site, 0-based.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "relative_path": {
              "description": "Path relative to the repository root (backslashes are normalised to `/`).",
              "type": "string"
            },
            "repo": {
              "description": "Repository identity.",
              "type": "string"
            },
            "snapshot_commit": {
              "description": "Snapshot commit, 7 to 64 lowercase hex (SO-2): a short value is canonicalised to the\n40-hex commit it uniquely prefixes; stored as 40 hex.",
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "description": "SCIP symbol (stage1-spec G1-F9): content, scanned first, then grammar-checked\n(`symbol_invalid`); derived from `relative_path` and `name_path` when absent and a\nsnapshot resolves.",
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "description": "Tool of origin: `serena`, `manual` (agent-typed), `kaban-adr`.",
              "type": "string"
            }
          },
          "required": [
            "repo",
            "commit",
            "tool",
            "relative_path"
          ],
          "type": "object"
        },
        "LinkSpec": {
          "description": "An inline link in a `remember` call; exactly one of `to` / `from` names the other node.",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "description": "Source node id (the new node is the destination).",
              "type": [
                "string",
                "null"
              ]
            },
            "rel": {
              "description": "Relationship type.",
              "type": "string"
            },
            "to": {
              "description": "Destination node id (the new node is the source).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "rel"
          ],
          "type": "object"
        },
        "Location": {
          "additionalProperties": false,
          "description": "A position as Serena emits it (0-based line and column; core-spec §6).",
          "properties": {
            "column": {
              "description": "0-based column.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line": {
              "description": "0-based line.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "line",
            "column"
          ],
          "type": "object"
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agent_id": {
          "description": "Agent that produced the memory.",
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "description": "0..1 how sure you are.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "importance": {
          "description": "0..1 how important this is to recall later.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "description": "Node kind (label). Must exist in the schema; see `schema_describe` / `schema_extend`.",
          "type": "string"
        },
        "links": {
          "default": [],
          "description": "Links created atomically with the node: `[{\"rel\":\"FIXED_BY\",\"to\":\"<id>\"}]` or `{\"rel\":..,\"from\":\"<id>\"}`.",
          "items": {
            "$ref": "#/$defs/LinkSpec"
          },
          "type": "array"
        },
        "path_scope": {
          "default": [],
          "description": "Globs or paths a governing record (Decision, Convention) covers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "props": {
          "description": "Kind-specific properties (every string leaf is scanned by the denylist). Decision,\nConvention and Failure props are typed: unknown keys are rejected and a Decision needs\n`rationale`."
        },
        "refs": {
          "default": [],
          "description": "Code references the memory is about, stored as `CodeRef` nodes linked `ABOUT` (deduplicated\nby content). Serena output can be converted with the `coderefs_from_serena` adapter.",
          "items": {
            "$ref": "#/$defs/CodeRefWire"
          },
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoreScope"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which store the memory lives in: `project` (default). `personal` arrives in M6."
        },
        "session_id": {
          "description": "Session that produced the memory (`source_session` is accepted as an alias, MD-26).",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "description": "Optional one-line summary used for compact recall cards.",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "default": [],
          "description": "Free-form tags (max 32).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "The memory text. Scanned by the denylist before anything is stored.",
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace the memory belongs to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "name": "remember",
    "outputSchema": {
      "$defs": {
        "Card": {
          "description": "Outgoing projection of a node (re-scanned on read when the policy says so).",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "created_at": {
              "description": "Creation time (RFC 3339).",
              "type": "string"
            },
            "governance": {
              "$ref": "#/$defs/Governance",
              "description": "Governance state (`none` for kinds other than Decision, Convention and Failure)."
            },
            "id": {
              "description": "Node id.",
              "type": "string"
            },
            "kind": {
              "description": "Node kind.",
              "type": "string"
            },
            "lifecycle": {
              "$ref": "#/$defs/Lifecycle",
              "description": "Storage visibility (`active` unless the read opted into archived records)."
            },
            "props": {
              "description": "Props (full text only, omitted when empty)."
            },
            "provenance": {
              "$ref": "#/$defs/Provenance",
              "default": {
                "store": "project"
              },
              "description": "Who produced the record and where it lives."
            },
            "redactions": {
              "description": "`field:rule` entries for redactions applied on read (omitted when none).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "score": {
              "description": "Fused score (recall only), rounded to 3 decimals.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "summary": {
              "description": "Summary, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "description": "Tags (omitted when empty).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "description": "Text (present when full text was requested or the node has no summary).",
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "description": "Why the card was returned (recall only).",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "workspace_id": {
              "description": "Workspace id (every row carries one, F17).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "lifecycle",
            "governance",
            "created_at",
            "workspace_id",
            "provenance"
          ],
          "type": "object"
        },
        "Governance": {
          "description": "Governance state of a `Decision`, `Convention` or `Failure`; [`Governance::None`] for every\nother kind.",
          "oneOf": [
            {
              "const": "none",
              "description": "The kind is not governed.",
              "type": "string"
            },
            {
              "const": "proposed",
              "description": "Recorded, not yet accepted (ranked below accepted in `why`).",
              "type": "string"
            },
            {
              "const": "accepted",
              "description": "Accepted with reason and path scope (event recorded).",
              "type": "string"
            },
            {
              "const": "superseded",
              "description": "Replaced by a newer record (`SUPERSEDES` edge plus event).",
              "type": "string"
            },
            {
              "const": "invalidated",
              "description": "Declared no longer valid (event recorded).",
              "type": "string"
            }
          ]
        },
        "Lifecycle": {
          "description": "Storage visibility of a node. Reads default to [`Lifecycle::Active`].",
          "oneOf": [
            {
              "const": "active",
              "description": "Visible to recall, traverse and get.",
              "type": "string"
            },
            {
              "const": "archived",
              "description": "Kept and reachable through graph expansion or `include_archived`; not in the text index.",
              "type": "string"
            },
            {
              "const": "tombstoned",
              "description": "Hidden everywhere; never re-proposed as a duplicate. Terminal except for purge.",
              "type": "string"
            },
            {
              "const": "purged",
              "description": "Text, index entries and edges removed; only the id row remains so it never reappears.",
              "type": "string"
            }
          ]
        },
        "Provenance": {
          "description": "Where a card came from (core-spec F3 \"cards with provenance\"; core-plan C3.5). Every string\nis a persisted node string, masked by the read projection like the rest of the card.",
          "properties": {
            "agent_id": {
              "description": "Agent that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "commit_sha": {
              "description": "Commit the record was taken at, when stamped.",
              "type": [
                "string",
                "null"
              ]
            },
            "repo": {
              "description": "Repository identity (the root directory name, M3-23).",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "description": "Session that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "store": {
              "$ref": "#/$defs/StoreScope",
              "description": "Which store the record lives in (`project`; `personal` arrives in M6)."
            }
          },
          "required": [
            "store"
          ],
          "type": "object"
        },
        "RememberStatus": {
          "description": "Whether `remember` created a node or found an existing duplicate.",
          "oneOf": [
            {
              "const": "created",
              "description": "A new node was stored.",
              "type": "string"
            },
            {
              "const": "existing",
              "description": "An active node with identical content already existed; nothing was stored.",
              "type": "string"
            }
          ]
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        },
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). On FTS5 the index is written in the\nmutation's own transaction, so a commit is searchable at once. An index with its own\nstorage (Tantivy, SS-09) publishes behind the commit: the service waits one bounded\nbarrier for the serving reader to cover the receipt's position and otherwise reports the\nthird outcome, which is never a rejection and is never replayed. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            },
            {
              "const": "committed_not_yet_searchable",
              "description": "Committed, and the search index had not incorporated the receipt's position when the\nvisibility barrier expired or failed: the write stands, a later search will show it,\ndo not replay the mutation. CLI status 6.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected`, `committed` or `committed_not_yet_searchable` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "candidate_duplicates": {
          "description": "Active Decisions of the workspace with the same normalized title and `path_scope` (F1\nnear-duplicates); the node was still created, nothing is merged.",
          "items": {
            "$ref": "#/$defs/Card"
          },
          "type": "array"
        },
        "fields_ignored": {
          "description": "On `existing`: request fields whose values differed from the stored node and were not\napplied (the first write wins).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Node id.",
          "type": "string"
        },
        "kind": {
          "description": "Node kind.",
          "type": "string"
        },
        "links": {
          "description": "Number of inline links created (only when `created`; kept for the spike contract).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "links_created": {
          "default": 0,
          "description": "Number of requested links created or refreshed, on a new or an existing node (m2 N5).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "links_ignored": {
          "default": false,
          "description": "Always `false`: links are never dropped on dedup (m2 N5). Present for the contract.",
          "type": "boolean"
        },
        "receipt": {
          "$ref": "#/$defs/WriteReceipt",
          "description": "The write's receipt (spec 05 SS-10): outcome, store identities and `ChangeLog` position."
        },
        "redactions": {
          "description": "`field:rule` entries for every redaction applied.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/RememberStatus",
          "description": "Created or existing."
        }
      },
      "required": [
        "status",
        "id",
        "kind",
        "redactions",
        "links_created",
        "links_ignored",
        "receipt"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Describe schema"
    },
    "description": "Describe the current graph schema: node kinds (labels) and relationship types with descriptions and endpoint constraints. Also available as resource kaban://schema.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    },
    "name": "schema_describe",
    "outputSchema": {
      "$defs": {
        "KindStat": {
          "description": "One `kind_stats` row (EN-F6): the per-workspace counters of a discovered (or promoted)\nkind. `mean_score` stays `NULL` until E2 scores claims.",
          "properties": {
            "first_seen": {
              "description": "Unix seconds of the first node.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "description": "Bare kind name.",
              "type": "string"
            },
            "last_seen": {
              "description": "Unix seconds of the latest node.",
              "format": "int64",
              "type": "integer"
            },
            "mean_score": {
              "description": "Mean extractor score (E2; `None` until then).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "n_nodes": {
              "description": "Active nodes of the kind in the workspace.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "n_sources": {
              "description": "Distinct sources (session or agent identity) that wrote them.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "ns": {
              "description": "Namespace (`x` for a discovered kind).",
              "type": "string"
            },
            "workspace_id": {
              "description": "Workspace the counters belong to.",
              "type": "string"
            }
          },
          "required": [
            "workspace_id",
            "ns",
            "kind",
            "n_nodes",
            "n_sources",
            "first_seen",
            "last_seen"
          ],
          "type": "object"
        },
        "Naming": {
          "description": "Naming conventions echoed by `schema_describe`.",
          "properties": {
            "label": {
              "description": "Label convention.",
              "type": "string"
            },
            "rel": {
              "description": "Relationship type convention.",
              "type": "string"
            }
          },
          "required": [
            "label",
            "rel"
          ],
          "type": "object"
        },
        "TypeDef": {
          "description": "A schema entry: a node kind (`label`) or a relationship type (`rel`).",
          "properties": {
            "builtin": {
              "default": false,
              "description": "Builtin entries cannot be changed.",
              "type": "boolean"
            },
            "column_weights": {
              "description": "The `column_weights` block (EN-F29)."
            },
            "description": {
              "description": "Human description.",
              "type": "string"
            },
            "directed": {
              "default": true,
              "description": "Whether the relationship is directed (default true).",
              "type": "boolean"
            },
            "display": {
              "description": "The display labels (`governed.display`)."
            },
            "extract": {
              "description": "The `extract` block (EN-F25, EN-F36)."
            },
            "from_kinds": {
              "default": [],
              "description": "For rels: allowed source kinds (empty = any).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "governed": {
              "description": "The `governed` block (EN-F4)."
            },
            "kind": {
              "description": "`\"label\"` or `\"rel\"`.",
              "type": "string"
            },
            "name": {
              "description": "The **stored name** (engine-spec §3.1): `PascalCase` for labels, `UPPER_SNAKE_CASE` for\nrels, bare for the `core`, `adr` and `user` namespaces and `ns:Name` for every other\nnamespace (`incidents:Decision`). This is the name `node.kind` and `edge.rel` carry.",
              "type": "string"
            },
            "ns": {
              "default": null,
              "description": "The declaring namespace (engine-plan E1.3, E1.7): since migration 0004 the store\npersists it in `schema_type.ns` (`PRIMARY KEY(ns, kind, name)`) and reads it back from\nthe column (`core`, `adr`, `user`, or the prefix of a stored `ns:Name`); a store still\nat schema 0003 reports `None` and the API derives it from the stored name. Ignored on\nwrite: `schema_extend` takes the namespace from the stored name.",
              "type": [
                "string",
                "null"
              ]
            },
            "props_schema": {
              "default": null,
              "description": "Optional JSON schema for props."
            },
            "rank": {
              "description": "The `rank` block (EN-F29)."
            },
            "to_kinds": {
              "default": [],
              "description": "For rels: allowed destination kinds (empty = any).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name",
            "ns",
            "description",
            "from_kinds",
            "to_kinds",
            "directed",
            "props_schema",
            "builtin"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "kind_stats": {
          "description": "The discovered-kind counters of the request's workspace (engine-spec EN-F6; engine-plan\nE1.8), empty when no label was ever discovered there.",
          "items": {
            "$ref": "#/$defs/KindStat"
          },
          "type": "array"
        },
        "labels": {
          "description": "Node kinds.",
          "items": {
            "$ref": "#/$defs/TypeDef"
          },
          "type": "array"
        },
        "naming": {
          "$ref": "#/$defs/Naming",
          "description": "Naming conventions."
        },
        "relationships": {
          "description": "Relationship types.",
          "items": {
            "$ref": "#/$defs/TypeDef"
          },
          "type": "array"
        }
      },
      "required": [
        "labels",
        "relationships",
        "naming"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Extend schema"
    },
    "description": "Register a new node kind (label, PascalCase) or relationship type (rel, UPPER_SNAKE_CASE) with a description and optional endpoint constraints, so the graph can grow new shapes at runtime. Builtin types cannot be changed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "description": {
          "description": "Human description (required).",
          "type": "string"
        },
        "directed": {
          "description": "Directed relationship (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "from_kinds": {
          "default": [],
          "description": "For rels: allowed source kinds (empty = any).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "\"label\" (node kind) or \"rel\" (relationship type)",
          "type": "string"
        },
        "name": {
          "description": "`PascalCase` for labels, `UPPER_SNAKE_CASE` for rels.",
          "type": "string"
        },
        "props_schema": {
          "description": "Optional JSON schema for props."
        },
        "to_kinds": {
          "default": [],
          "description": "For rels: allowed destination kinds (empty = any).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "name",
        "description"
      ],
      "type": "object"
    },
    "name": "schema_extend",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "builtin": {
          "default": false,
          "description": "Builtin entries cannot be changed.",
          "type": "boolean"
        },
        "column_weights": {
          "description": "The `column_weights` block (EN-F29)."
        },
        "description": {
          "description": "Human description.",
          "type": "string"
        },
        "directed": {
          "default": true,
          "description": "Whether the relationship is directed (default true).",
          "type": "boolean"
        },
        "display": {
          "description": "The display labels (`governed.display`)."
        },
        "extract": {
          "description": "The `extract` block (EN-F25, EN-F36)."
        },
        "from_kinds": {
          "default": [],
          "description": "For rels: allowed source kinds (empty = any).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "governed": {
          "description": "The `governed` block (EN-F4)."
        },
        "kind": {
          "description": "`\"label\"` or `\"rel\"`.",
          "type": "string"
        },
        "name": {
          "description": "The **stored name** (engine-spec §3.1): `PascalCase` for labels, `UPPER_SNAKE_CASE` for\nrels, bare for the `core`, `adr` and `user` namespaces and `ns:Name` for every other\nnamespace (`incidents:Decision`). This is the name `node.kind` and `edge.rel` carry.",
          "type": "string"
        },
        "ns": {
          "default": null,
          "description": "The declaring namespace (engine-plan E1.3, E1.7): since migration 0004 the store\npersists it in `schema_type.ns` (`PRIMARY KEY(ns, kind, name)`) and reads it back from\nthe column (`core`, `adr`, `user`, or the prefix of a stored `ns:Name`); a store still\nat schema 0003 reports `None` and the API derives it from the stored name. Ignored on\nwrite: `schema_extend` takes the namespace from the stored name.",
          "type": [
            "string",
            "null"
          ]
        },
        "props_schema": {
          "default": null,
          "description": "Optional JSON schema for props."
        },
        "rank": {
          "description": "The `rank` block (EN-F29)."
        },
        "to_kinds": {
          "default": [],
          "description": "For rels: allowed destination kinds (empty = any).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "name",
        "ns",
        "description",
        "from_kinds",
        "to_kinds",
        "directed",
        "props_schema",
        "builtin"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Stats"
    },
    "description": "Counts of nodes/edges by kind and relationship in the bound workspace (workspace_id \"*\" for all), database size, denylist policy version.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "workspace_id": {
          "description": "Workspace to count (default: the server's bound workspace; `\"*\"` for all). Database\nfile bytes are always global.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "stats",
    "outputSchema": {
      "$defs": {
        "Layer": {
          "description": "Assertion source layers in strongest-source order (engine-spec EN-E7); the text index layers `fts` and `fuzzy` (EN-F22, spec 05 OWN-M) close the list.",
          "oneOf": [
            {
              "const": "human",
              "description": "`human`",
              "type": "string"
            },
            {
              "const": "v4",
              "description": "`v4`",
              "type": "string"
            },
            {
              "const": "reconcile",
              "description": "`reconcile`",
              "type": "string"
            },
            {
              "const": "script",
              "description": "`script`",
              "type": "string"
            },
            {
              "const": "llm",
              "description": "`llm`",
              "type": "string"
            },
            {
              "const": "gliner",
              "description": "`gliner`",
              "type": "string"
            },
            {
              "const": "gazetteer",
              "description": "`gazetteer`",
              "type": "string"
            },
            {
              "const": "embed",
              "description": "`embed`",
              "type": "string"
            },
            {
              "const": "fts",
              "description": "`fts`",
              "type": "string"
            },
            {
              "const": "fuzzy",
              "description": "`fuzzy`",
              "type": "string"
            }
          ]
        },
        "LayerOutcome": {
          "description": "A fixed, content-free producer result stored under `layer_run:<layer>`.",
          "oneOf": [
            {
              "const": "ok",
              "description": "Completed.",
              "type": "string"
            },
            {
              "const": "failed",
              "description": "Producer failed; other layers remain usable.",
              "type": "string"
            },
            {
              "const": "skipped_budget",
              "description": "Resource cap prevented this layer from running.",
              "type": "string"
            }
          ]
        },
        "LayerRow": {
          "description": "One of the five default-matrix rows.",
          "properties": {
            "last_outcome": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LayerOutcome"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last fixed run outcome, absent when no valid bookkeeping exists."
            },
            "last_run": {
              "description": "Latest valid run timestamp, including explicitly selected runs.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "layer": {
              "$ref": "#/$defs/MatrixLayer",
              "description": "Matrix display category (not a producer vocabulary extension)."
            },
            "on": {
              "description": "Whether configuration enables the layer by default.",
              "type": "boolean"
            },
            "owner": {
              "description": "Edge producer, when the layer has one.",
              "type": [
                "string",
                "null"
              ]
            },
            "producer_layers": {
              "description": "Actual closed-vocabulary sources represented by the row.",
              "items": {
                "$ref": "#/$defs/Layer"
              },
              "type": "array"
            },
            "reason_off": {
              "description": "Fixed reason when the default is disabled.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "layer",
            "producer_layers",
            "on",
            "owner",
            "last_run",
            "last_outcome",
            "reason_off"
          ],
          "type": "object"
        },
        "MatrixLayer": {
          "description": "Display categories, not new assertion-source vocabulary values.",
          "oneOf": [
            {
              "const": "fts",
              "description": "L0 lexical index and chunks.",
              "type": "string"
            },
            {
              "const": "gazetteer",
              "description": "L1 optional mention dictionary.",
              "type": "string"
            },
            {
              "const": "embed",
              "description": "Reserved L2 embeddings, unavailable in this release (OWN-94).",
              "type": "string"
            },
            {
              "const": "extractors",
              "description": "L3 explicit extractors (llm, gliner and script).",
              "type": "string"
            }
          ]
        },
        "PolicyStats": {
          "description": "Policy summary in `stats`.",
          "properties": {
            "effective_hash": {
              "description": "Effective hash of the loaded rules (builtin and user; the version stamped on judged\nnodes and compared by the rescan job, MD-19).",
              "type": "string"
            },
            "phrases": {
              "description": "Number of denylist phrases.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "rules": {
              "description": "Number of regex rules.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "scan_on_read": {
              "description": "Whether stored text is re-scanned on read.",
              "type": "boolean"
            },
            "version": {
              "description": "Policy version hash (sha256 of the policy file bytes).",
              "type": "string"
            },
            "words": {
              "description": "Number of denylist words.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "version",
            "effective_hash",
            "rules",
            "words",
            "phrases",
            "scan_on_read"
          ],
          "type": "object"
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "properties": {
        "layers": {
          "default": [],
          "description": "Five default-matrix categories and last valid producer runs (EN-F52).",
          "items": {
            "$ref": "#/$defs/LayerRow"
          },
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/PolicyStats",
          "description": "Policy summary."
        },
        "stores": {
          "description": "Stores this server reads (`project`; `personal` arrives in M6, F18).",
          "items": {
            "$ref": "#/$defs/StoreScope"
          },
          "type": "array"
        }
      },
      "required": [
        "stores",
        "policy",
        "layers"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Traverse"
    },
    "description": "Bounded graph traversal from one or more node ids along selected relationship types (direction out|in|both, depth 1-4). Returns active nodes and the edges among them.",
    "inputSchema": {
      "$defs": {
        "EdgeFilter": {
          "description": "The edge filter of `traverse` (EN-F46). Values are the stored vocabulary spellings:\nlayers `human`, `v4`, `reconcile`, `script`, `llm`, `gliner`, `gazetteer`, `embed`;\nmethods such as `link`, `remember`, `exact`, `alias`, `symbol`, `gliner`, `llm`. An\nunknown spelling is refused (`unknown_layer`, `unknown_method`).",
          "properties": {
            "layers": {
              "description": "Keep only edges from these source layers (empty: any).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "methods": {
              "description": "Keep only edges asserted by these methods (empty: any).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "min_score": {
              "description": "Keep only edges whose score is at least this (0..1).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Governance": {
          "description": "Governance state of a `Decision`, `Convention` or `Failure`; [`Governance::None`] for every\nother kind.",
          "oneOf": [
            {
              "const": "none",
              "description": "The kind is not governed.",
              "type": "string"
            },
            {
              "const": "proposed",
              "description": "Recorded, not yet accepted (ranked below accepted in `why`).",
              "type": "string"
            },
            {
              "const": "accepted",
              "description": "Accepted with reason and path scope (event recorded).",
              "type": "string"
            },
            {
              "const": "superseded",
              "description": "Replaced by a newer record (`SUPERSEDES` edge plus event).",
              "type": "string"
            },
            {
              "const": "invalidated",
              "description": "Declared no longer valid (event recorded).",
              "type": "string"
            }
          ]
        },
        "TraverseDirection": {
          "description": "Which edges a traversal follows from a node (MT-5, `rust-bp-review-dispositions.md` RB-4).\nClosed set: an unknown wire value fails deserialization.",
          "oneOf": [
            {
              "const": "out",
              "description": "Outgoing edges only (`src` = the node).",
              "type": "string"
            },
            {
              "const": "in",
              "description": "Incoming edges only (`dst` = the node).",
              "type": "string"
            },
            {
              "const": "both",
              "description": "Both directions (the default).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraverseDirection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which edges to follow: `out`, `in` or `both` (default both). A closed set: any other\nvalue is refused."
        },
        "edge_filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeFilter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Follow only the edges that pass every clause: a source layer in `layers`, a method in\n`methods`, a score of at least `min_score`. An edge without a value in a filtered column\n(a structural edge written without a claim) does not pass that clause. Default: every\nedge."
        },
        "follow_anchors": {
          "default": false,
          "description": "Expand each reached node that anchors a code symbol or path one step into the current\ncode-graph snapshot (EN-F19): the snapshot rows come back in `anchored` as `symbol` and\n`file` cards, 200 per anchored node and 500 in total; depth and the node limit are\nunchanged. Default false; nothing is added when no snapshot resolves.",
          "type": "boolean"
        },
        "governance": {
          "default": [],
          "description": "Keep only nodes in these governance states (`none`, `proposed`, `accepted`,\n`superseded`, `invalidated`); default: any.",
          "items": {
            "$ref": "#/$defs/Governance"
          },
          "type": "array"
        },
        "include_candidates": {
          "default": false,
          "description": "Also return candidate records (an `x:` record still under review, a record a\nreconciliation left for review); default false: candidates are absent from the nodes,\nthe edges and the start ids alike. `kaban review` and `explain` list them either way.",
          "type": "boolean"
        },
        "kind_set": {
          "description": "Keep only the kinds of this ontology-defined set, in addition to `node_kinds`:\n`governing` (the kinds whose records govern paths) is the one set; any other value is\nrefused (`unknown_kind_set`).",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Max nodes (default 100, max 500).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "description": "1..4 (default 1)",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "node_kinds": {
          "default": [],
          "description": "Keep only these node kinds. A kind the loaded ontology does not declare is refused\n(`unknown_kind`), as is an undeclared relationship type in `rels` (`unknown_rel`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rels": {
          "default": [],
          "description": "Follow only these relationship types.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "start_ids": {
          "description": "Starting node ids (1..64).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace_id": {
          "description": "Workspace to traverse (default: the server's bound workspace; `\"*\"` for all).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "start_ids"
      ],
      "type": "object"
    },
    "name": "traverse",
    "outputSchema": {
      "$defs": {
        "AnchoredCard": {
          "description": "One code-graph card of `anchored[]` (EN-F19; CG-JOIN v1 §9 order `(path, ref)`).",
          "properties": {
            "from": {
              "description": "The returned node whose anchor reached this card.",
              "type": "string"
            },
            "key": {
              "description": "The symbol's cross-commit key (absent for a file or a key-less symbol).",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/AnchoredKind",
              "description": "`symbol` or `file`."
            },
            "name": {
              "description": "The symbol's name (absent for a file).",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "The file path: the card itself for a `file`, the defining file for a `symbol`.",
              "type": "string"
            },
            "ref": {
              "description": "The symbol's stable `ref` (absent for a file).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "from",
            "kind",
            "path"
          ],
          "type": "object"
        },
        "AnchoredKind": {
          "description": "What kind of snapshot row an [`AnchoredRow`] is (the stage 1 card kinds).",
          "oneOf": [
            {
              "const": "symbol",
              "description": "A `cg.symbols` row (`kind = 'symbol'`, `external = 0`).",
              "type": "string"
            },
            {
              "const": "file",
              "description": "A `cg.files` row.",
              "type": "string"
            }
          ]
        },
        "Card": {
          "description": "Outgoing projection of a node (re-scanned on read when the policy says so).",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "created_at": {
              "description": "Creation time (RFC 3339).",
              "type": "string"
            },
            "governance": {
              "$ref": "#/$defs/Governance",
              "description": "Governance state (`none` for kinds other than Decision, Convention and Failure)."
            },
            "id": {
              "description": "Node id.",
              "type": "string"
            },
            "kind": {
              "description": "Node kind.",
              "type": "string"
            },
            "lifecycle": {
              "$ref": "#/$defs/Lifecycle",
              "description": "Storage visibility (`active` unless the read opted into archived records)."
            },
            "props": {
              "description": "Props (full text only, omitted when empty)."
            },
            "provenance": {
              "$ref": "#/$defs/Provenance",
              "default": {
                "store": "project"
              },
              "description": "Who produced the record and where it lives."
            },
            "redactions": {
              "description": "`field:rule` entries for redactions applied on read (omitted when none).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "score": {
              "description": "Fused score (recall only), rounded to 3 decimals.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "summary": {
              "description": "Summary, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "description": "Tags (omitted when empty).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "description": "Text (present when full text was requested or the node has no summary).",
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "description": "Why the card was returned (recall only).",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "workspace_id": {
              "description": "Workspace id (every row carries one, F17).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "lifecycle",
            "governance",
            "created_at",
            "workspace_id",
            "provenance"
          ],
          "type": "object"
        },
        "EdgeCard": {
          "description": "Outgoing projection of an edge.",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "description": "Source node id.",
              "type": "string"
            },
            "id": {
              "description": "Edge id.",
              "type": "string"
            },
            "rel": {
              "description": "Relationship type.",
              "type": "string"
            },
            "to": {
              "description": "Destination node id.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "from",
            "rel",
            "to",
            "confidence"
          ],
          "type": "object"
        },
        "Governance": {
          "description": "Governance state of a `Decision`, `Convention` or `Failure`; [`Governance::None`] for every\nother kind.",
          "oneOf": [
            {
              "const": "none",
              "description": "The kind is not governed.",
              "type": "string"
            },
            {
              "const": "proposed",
              "description": "Recorded, not yet accepted (ranked below accepted in `why`).",
              "type": "string"
            },
            {
              "const": "accepted",
              "description": "Accepted with reason and path scope (event recorded).",
              "type": "string"
            },
            {
              "const": "superseded",
              "description": "Replaced by a newer record (`SUPERSEDES` edge plus event).",
              "type": "string"
            },
            {
              "const": "invalidated",
              "description": "Declared no longer valid (event recorded).",
              "type": "string"
            }
          ]
        },
        "Lifecycle": {
          "description": "Storage visibility of a node. Reads default to [`Lifecycle::Active`].",
          "oneOf": [
            {
              "const": "active",
              "description": "Visible to recall, traverse and get.",
              "type": "string"
            },
            {
              "const": "archived",
              "description": "Kept and reachable through graph expansion or `include_archived`; not in the text index.",
              "type": "string"
            },
            {
              "const": "tombstoned",
              "description": "Hidden everywhere; never re-proposed as a duplicate. Terminal except for purge.",
              "type": "string"
            },
            {
              "const": "purged",
              "description": "Text, index entries and edges removed; only the id row remains so it never reappears.",
              "type": "string"
            }
          ]
        },
        "Provenance": {
          "description": "Where a card came from (core-spec F3 \"cards with provenance\"; core-plan C3.5). Every string\nis a persisted node string, masked by the read projection like the rest of the card.",
          "properties": {
            "agent_id": {
              "description": "Agent that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "commit_sha": {
              "description": "Commit the record was taken at, when stamped.",
              "type": [
                "string",
                "null"
              ]
            },
            "repo": {
              "description": "Repository identity (the root directory name, M3-23).",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "description": "Session that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "store": {
              "$ref": "#/$defs/StoreScope",
              "description": "Which store the record lives in (`project`; `personal` arrives in M6)."
            }
          },
          "required": [
            "store"
          ],
          "type": "object"
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "anchored": {
          "default": [],
          "description": "Code-graph cards reached through the anchors of the returned nodes\n(`follow_anchors`); empty otherwise.",
          "items": {
            "$ref": "#/$defs/AnchoredCard"
          },
          "type": "array"
        },
        "edges": {
          "description": "Edges among the returned nodes.",
          "items": {
            "$ref": "#/$defs/EdgeCard"
          },
          "type": "array"
        },
        "nodes": {
          "description": "Nodes reached.",
          "items": {
            "$ref": "#/$defs/Card"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges",
        "anchored"
      ],
      "type": "object"
    }
  }
]
