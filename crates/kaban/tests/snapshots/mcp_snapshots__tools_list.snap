        "Edge": {
          "description": "One edge of a neighbourhood, by node refs (stage1-spec §6 `Edge`): `from` and `to` are\ncontent refs, `type` the closed edge-type name.",
          "properties": {
            "from": {
              "description": "Source ref.",
              "type": "string"
            },
            "to": {
