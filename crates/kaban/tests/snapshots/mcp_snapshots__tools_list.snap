              },
              "type": "array"
            },
            "chosen": {
              "description": "Explicit or suggested source type used for kind selection.",
              "type": "string"
            },
            "note": {
              "description": "Advisory warning/explanation; never an acceptance promise.",
              "type": "string"
            }
          },
          "required": [
            "candidates",
            "chosen",
            "note"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "about_candidates": {
          "default": [],
