          "type": [
            "string",
            "null"
          ]
        },
        "include_snippets": {
          "default": false,
          "description": "Include each card's snippet (G1-F17).",
          "type": "boolean"
        },
        "limit": {
          "description": "Max rows (default 50, max 200); `truncated: true` says more existed.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "target": {
