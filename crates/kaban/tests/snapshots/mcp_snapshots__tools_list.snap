            "json_schema",
            "required",
            "semantics",
            "allowed_edges",
            "kaban_adds",
            "governance"
          ],
          "type": "object"
        },
        "TypeCandidate": {
          "additionalProperties": false,
          "description": "Advisory source type; never supplies record fields or acceptance evidence.",
          "properties": {
            "confidence": {
              "description": "Bounded heuristic score, not model confidence.",
              "format": "double",
              "type": "number"
            },
            "signals": {
              "description": "Advisory signal descriptions, possibly empty.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "description": "Source-type spelling from the deterministic signal selector.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "confidence",
            "signals"
          ],
          "type": "object"
        },
        "TypeSuggestion": {
          "additionalProperties": false,
          "description": "Source-type selection and advisory candidates.",
          "properties": {
            "candidates": {
              "description": "Source-order independent deterministic candidates.",
              "items": {
