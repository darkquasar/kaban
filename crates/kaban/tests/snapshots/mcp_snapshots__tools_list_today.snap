  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Stats"
    },
    "description": "Counts of nodes/edges by kind and relationship in the bound workspace (workspace_id \"*\" for all), database size, denylist policy version.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "workspace_id": {
          "description": "Workspace to count (default: the server's bound workspace; `\"*\"` for all). Database\nfile bytes are always global.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "stats",
    "outputSchema": {
      "$defs": {
        "BudgetOrigin": {
          "description": "Owned wire provenance: flag spelling is reported separately.",
          "oneOf": [
            {
              "const": "default",
              "description": "Register default.",
              "type": "string"
            },
            {
              "const": "config",
              "description": "Saved override.",
              "type": "string"
            },
            {
              "const": "flag",
              "description": "Run-local flag.",
              "type": "string"
            }
          ]
        },
        "BudgetRow": {
          "description": "An owned resource-policy row, suitable for report round trips.",
          "properties": {
            "cap_lifted": {
              "description": "Whether enforcement is explicitly bypassed for this run.",
              "type": "boolean"
            },
            "default": {
              "description": "Register value, in the key's documented units.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "effective": {
              "description": "Configured value, not a sentinel for a lifted cap.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "flag": {
              "description": "Fixed flag spelling when a run lifts the cap.",
              "type": [
                "string",
                "null"
              ]
            },
            "group": {
              "description": "The producer or index the budget bounds (`text`, `gazetteer`, `document_ingest`,\n`scip_import`).",
              "type": "string"
            },
            "key": {
              "description": "Dotted configuration key.",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/BudgetOrigin",
              "description": "Policy provenance."
            }
          },
          "required": [
            "group",
            "key",
            "default",
            "effective",
            "source",
            "cap_lifted"
          ],
          "type": "object"
        },
        "CatalogIndexStatus": {
          "description": "The catalog state of one derived index (PC-16's `IndexStatus`; named apart from the\ndocument index's `index_status` response), from the catalog's verification.",
          "properties": {
            "base_generation": {
              "description": "The generation that published the live base, if the index has one.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "index": {
              "$ref": "#/$defs/IndexName",
              "description": "Which index."
            },
            "last_compaction": {
              "description": "The newest generation that published a live extent of the index (the last compaction\nthat changed it), if any.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "layers": {
              "description": "Live layers (extents over the base).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "sediment_rows": {
              "description": "Pending sediment rows not yet sealed into a layer.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "index",
            "sediment_rows",
            "layers",
            "base_generation",
            "last_compaction"
          ],
          "type": "object"
        },
        "IndexName": {
          "description": "A derived index on the catalog (PC-16).",
          "oneOf": [
            {
              "const": "text",
              "description": "The text index.",
              "type": "string"
            },
            {
              "const": "graph",
              "description": "The memory graph.",
              "type": "string"
            },
            {
              "const": "code",
              "description": "The code graph.",
              "type": "string"
            }
          ]
        },
        "PolicyStats": {
          "description": "Policy summary in `stats`.",
          "properties": {
            "effective_hash": {
              "description": "Effective hash of the loaded rules (builtin and user; the version stamped on judged\nnodes and compared by the rescan job, MD-19).",
              "type": "string"
            },
            "phrases": {
              "description": "Number of denylist phrases.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "rules": {
              "description": "Number of regex rules.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "scan_on_read": {
              "description": "Whether stored text is re-scanned on read.",
              "type": "boolean"
            },
            "version": {
              "description": "Policy version hash (sha256 of the policy file bytes).",
              "type": "string"
            },
            "words": {
              "description": "Number of denylist words.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "version",
            "effective_hash",
            "rules",
            "words",
            "phrases",
            "scan_on_read"
          ],
          "type": "object"
        },
        "ProducerOutcome": {
          "description": "A fixed, content-free producer result stored under `producer_run:<producer>`.",
          "oneOf": [
            {
              "const": "ok",
              "description": "Completed.",
              "type": "string"
            },
            {
              "const": "failed",
              "description": "Producer failed; the other producers remain usable.",
              "type": "string"
            },
            {
              "const": "skipped_budget",
              "description": "Resource cap prevented this producer from running.",
              "type": "string"
            }
          ]
        },
        "ProducerRow": {
          "description": "One `stats.producers` row (PC-16): a producer, whether it runs by default, its last run\nand the budgets that bound it.",
          "properties": {
            "budgets": {
              "description": "The resource budgets that bound the producer (empty when none does).",
              "items": {
                "$ref": "#/$defs/BudgetRow"
              },
              "type": "array"
            },
            "last_outcome": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProducerOutcome"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last fixed run outcome, absent when no valid bookkeeping exists."
            },
            "last_run": {
              "description": "Latest valid run timestamp, including explicitly selected runs.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "on": {
              "description": "Whether the producer runs by default.",
              "type": "boolean"
            },
            "producer": {
              "description": "The producer (`extractor` stands for its three kinds).",
              "type": "string"
            },
            "reason_off": {
              "description": "Fixed reason when the producer is off by default.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "producer",
            "on",
            "last_run",
            "last_outcome",
            "reason_off",
            "budgets"
          ],
          "type": "object"
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "properties": {
        "indexes": {
          "default": [],
          "description": "The derived indexes on the catalog (PC-16), text, graph and code in that order; empty\nwhen the service has no catalog wired.",
          "items": {
            "$ref": "#/$defs/CatalogIndexStatus"
          },
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/PolicyStats",
          "description": "Policy summary."
        },
        "producers": {
          "default": [],
          "description": "The seven producers with their default state, last valid run and budgets (EN-F52,\nPC-16).",
          "items": {
            "$ref": "#/$defs/ProducerRow"
          },
          "type": "array"
        },
        "stores": {
          "description": "Stores this server reads (`project`; `personal` arrives in M6, F18).",
          "items": {
            "$ref": "#/$defs/StoreScope"
          },
          "type": "array"
        }
      },
      "required": [
        "stores",
        "policy",
        "producers",
        "indexes"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Traverse"
    },
    "description": "Bounded graph traversal from one or more node ids along selected relationship types (direction out|in|both, depth 1-4). Returns active nodes and the edges among them.",
    "inputSchema": {
      "$defs": {
        "EdgeFilter": {
          "additionalProperties": false,
          "description": "The edge filter of `traverse` (EN-F46). Values are the stored vocabulary spellings:\nproducers `authored`, `hook_events`, `document_ingest`, `gazetteer`, `extractor:llm`,\n`extractor:gliner`, `extractor:script`, `scip_import`, `git_history` (PC-16); methods such\nas `link`, `remember`, `exact`, `alias`, `symbol`, `gliner`, `llm`. An unknown spelling is\nrefused (`unknown_producer`, `unknown_method`), so is an unknown key (the removed `layers`\namong them).",
          "properties": {
            "methods": {
              "description": "Keep only edges asserted by these methods (empty: any).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "min_score": {
              "description": "Keep only edges whose score is at least this (0..1).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "producers": {
              "description": "Keep only edges from these producers (empty: any).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "TraverseDirection": {
          "description": "Which edges a traversal follows from a node (MT-5, `rust-bp-review-dispositions.md` RB-4).\nClosed set: an unknown wire value fails deserialization.",
          "oneOf": [
            {
              "const": "out",
              "description": "Outgoing edges only (`src` = the node).",
              "type": "string"
            },
            {
              "const": "in",
              "description": "Incoming edges only (`dst` = the node).",
              "type": "string"
            },
            {
              "const": "both",
              "description": "Both directions (the default).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraverseDirection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which edges to follow: `out`, `in` or `both` (default both). A closed set: any other\nvalue is refused."
        },
        "edge_filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeFilter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Follow only the edges that pass every clause: a producer in `producers`, a method in\n`methods`, a score of at least `min_score`. An edge without a value in a filtered column\n(a structural edge carries no method or score) does not pass that clause. Default:\nevery edge."
        },
        "limit": {
          "description": "Max nodes (default 100, max 500).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "description": "1..4 (default 1)",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "node_kinds": {
          "default": [],
          "description": "Keep only these node kinds. A kind the loaded ontology does not declare is refused\n(`unknown_kind`), as is an undeclared relationship type in `rels` (`unknown_rel`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rels": {
          "default": [],
          "description": "Follow only these relationship types.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "start_ids": {
          "description": "Starting node ids (1..64).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace_id": {
          "description": "Workspace to traverse (default: the server's bound workspace; `\"*\"` for all).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "start_ids"
      ],
      "type": "object"
    },
    "name": "traverse",
    "outputSchema": {
      "$defs": {
        "Card": {
          "description": "Outgoing projection of a node (re-scanned on read when the policy says so).",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "created_at": {
              "description": "Creation time (RFC 3339).",
              "type": "string"
            },
            "id": {
              "description": "Node id.",
              "type": "string"
            },
            "kind": {
              "description": "Node kind.",
              "type": "string"
            },
            "lifecycle": {
              "$ref": "#/$defs/Lifecycle",
              "description": "Storage visibility (`active` unless the read opted into archived records)."
            },
            "props": {
              "description": "Props (full text only, omitted when empty)."
            },
            "provenance": {
              "$ref": "#/$defs/Provenance",
              "default": {
                "store": "project"
              },
              "description": "Who produced the record and where it lives."
            },
            "redactions": {
              "description": "`field:rule` entries for redactions applied on read (omitted when none).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "score": {
              "description": "Fused score (recall only), rounded to 3 decimals.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "summary": {
              "description": "Summary, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "description": "Tags (omitted when empty).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "description": "Text (present when full text was requested or the node has no summary).",
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "description": "Why the card was returned (recall only).",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "workspace_id": {
              "description": "Workspace id (every row carries one, F17).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "lifecycle",
            "created_at",
            "workspace_id",
            "provenance"
          ],
          "type": "object"
        },
        "EdgeCard": {
          "description": "Outgoing projection of an edge.",
          "properties": {
            "confidence": {
              "description": "0..1 confidence.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "description": "Source node id.",
              "type": "string"
            },
            "id": {
              "description": "Edge id.",
              "type": "string"
            },
            "rel": {
              "description": "Relationship type.",
              "type": "string"
            },
            "to": {
              "description": "Destination node id.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "from",
            "rel",
            "to",
            "confidence"
          ],
          "type": "object"
        },
        "Lifecycle": {
          "description": "Storage visibility of a node. Reads default to [`Lifecycle::Active`].",
          "oneOf": [
            {
              "const": "active",
              "description": "Visible to recall, traverse and get.",
              "type": "string"
            },
            {
              "const": "archived",
              "description": "Kept and reachable through graph expansion or `include_archived`; not in the text index.",
              "type": "string"
            },
            {
              "const": "tombstoned",
              "description": "Hidden everywhere; never re-proposed as a duplicate. Terminal except for purge.",
              "type": "string"
            },
            {
              "const": "purged",
              "description": "Text, index entries and edges removed; only the id row remains so it never reappears.",
              "type": "string"
            }
          ]
        },
        "Provenance": {
          "description": "Where a card came from (core-spec F3 \"cards with provenance\"; core-plan C3.5). Every string\nis a persisted node string, masked by the read projection like the rest of the card.",
          "properties": {
            "agent_id": {
              "description": "Agent that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "commit_sha": {
              "description": "Commit the record was taken at, when stamped.",
              "type": [
                "string",
                "null"
              ]
            },
            "repo": {
              "description": "Repository identity (the root directory name, M3-23).",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "description": "Session that produced the record.",
              "type": [
                "string",
                "null"
              ]
            },
            "store": {
              "$ref": "#/$defs/StoreScope",
              "description": "Which store the record lives in (`project`; `personal` arrives in M6)."
            }
          },
          "required": [
            "store"
          ],
          "type": "object"
        },
        "StoreScope": {
          "description": "Which database a record lives in (core-spec §4 `store_scope`, F18).",
          "oneOf": [
            {
              "const": "project",
              "description": "The per-project database (default).",
              "type": "string"
            },
            {
              "const": "personal",
              "description": "The personal global database.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "edges": {
          "description": "Edges among the returned nodes.",
          "items": {
            "$ref": "#/$defs/EdgeCard"
          },
          "type": "array"
        },
        "nodes": {
          "description": "Nodes reached.",
          "items": {
            "$ref": "#/$defs/Card"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "type": "object"
    }
  }
]
