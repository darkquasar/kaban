---
source: crates/kaban/tests/mcp_snapshots.rs
expression: today
---
[
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Forget"
    },
    "description": "Forget a node: tombstone (default; keeps history, hidden from every read, never re-proposed as a duplicate), invalidate (the same effect as tombstone), archive (reachable by id and graph expansion only), or purge (destructive; removes text, index entries and edges, the id never reappears).",
    "inputSchema": {
      "$defs": {
        "ForgetMode": {
          "description": "How to forget a node (core-spec F5).",
          "oneOf": [
            {
              "const": "tombstone",
              "description": "Keep history, hide from every default read, never re-propose as a duplicate (default).",
              "type": "string"
            },
            {
              "const": "invalidate",
              "description": "The same lifecycle effect as `Tombstone`: the record is hidden from default reads.",
              "type": "string"
            },
            {
              "const": "archive",
              "description": "Archive: reachable by id and through graph expansion, out of the text index.",
              "type": "string"
            },
            {
              "const": "purge",
              "description": "Destructive: remove text, index entries and edges; the id row stays as `purged`.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Node id.",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForgetMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "tombstone (default: hidden, never re-proposed) | invalidate (the same effect as\ntombstone) | archive | purge (destructive: removes text, index entries and edges; the id\nnever reappears)"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "forget",
    "outputSchema": {
      "$defs": {
        "ForgetMode": {
          "description": "How to forget a node (core-spec F5).",
          "oneOf": [
            {
              "const": "tombstone",
              "description": "Keep history, hide from every default read, never re-propose as a duplicate (default).",
              "type": "string"
            },
            {
              "const": "invalidate",
              "description": "The same lifecycle effect as `Tombstone`: the record is hidden from default reads.",
              "type": "string"
            },
            {
              "const": "archive",
              "description": "Archive: reachable by id and through graph expansion, out of the text index.",
              "type": "string"
            },
            {
              "const": "purge",
              "description": "Destructive: remove text, index entries and edges; the id row stays as `purged`.",
              "type": "string"
            }
          ]
        },
        "Lifecycle": {
          "description": "Storage visibility of a node. Reads default to [`Lifecycle::Active`].",
          "oneOf": [
            {
              "const": "active",
              "description": "Visible to recall, traverse and get.",
              "type": "string"
            },
            {
              "const": "archived",
              "description": "Kept and reachable through graph expansion or `include_archived`; not in the text index.",
              "type": "string"
            },
            {
              "const": "tombstoned",
              "description": "Hidden everywhere; never re-proposed as a duplicate. Terminal except for purge.",
              "type": "string"
            },
            {
              "const": "purged",
              "description": "Text, index entries and edges removed; only the id row remains so it never reappears.",
              "type": "string"
            }
          ]
        },
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). Text is searchable at commit (spec 11 T7),\nso a committed mutation is visible to every search once the write returns. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected` or `committed` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cleanup": {
          "description": "Why a purge is not physically cleaned: the free-page residue until a VACUUM, after\n`busy` or the failure findings when a cleanup step did not run through; the revocation\nstands and `kaban doctor --optimize --vacuum` completes the cleanup.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Node id.",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "description": "Lifecycle after the call."
        },
        "mode": {
          "$ref": "#/$defs/ForgetMode",
          "description": "Mode applied."
        },
        "physically_cleaned": {
          "description": "The purge's freed pages were reclaimed by this call; the post-commit cleanup (index\nmerged, WAL truncated) reclaims none, so a purge reports `false` with `cleanup` naming\nthe residue. `false` for the other modes.",
          "type": "boolean"
        },
        "receipt": {
          "$ref": "#/$defs/WriteReceipt",
          "description": "The write's receipt (spec 05 SS-10): outcome, store identities and `ChangeLog` position."
        },
        "revoked": {
          "description": "A purge committed: the content is unavailable to every read from now on.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "mode",
        "lifecycle",
        "revoked",
        "physically_cleaned",
        "receipt"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Link"
    },
    "description": "Create a typed relationship between two existing nodes. The relationship type must be registered (see schema_describe / schema_extend). Re-linking the same (from, rel, to) updates confidence/props. SUPERSEDES/INVALIDATES mark the target node accordingly.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confidence": {
          "description": "0..1 confidence.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "from": {
          "description": "Source node id.",
          "type": "string"
        },
        "props": {
          "description": "Arbitrary JSON properties (scanned by the denylist)."
        },
        "rel": {
          "description": "Relationship type (must be registered).",
          "type": "string"
        },
        "to": {
          "description": "Destination node id.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "rel",
        "to"
      ],
      "type": "object"
    },
    "name": "link",
    "outputSchema": {
      "$defs": {
        "WriteOutcome": {
          "description": "What became of the requested mutation (SS-10). Text is searchable at commit (spec 11 T7),\nso a committed mutation is visible to every search once the write returns. The enum is\n`non_exhaustive` so a further outcome lands without touching a caller.",
          "oneOf": [
            {
              "const": "rejected",
              "description": "The requested mutation did not commit (nothing stored; the existing rejection auditing\nand the reason-specific nonzero CLI status stand). The error that refused it says why.",
              "type": "string"
            },
            {
              "const": "committed",
              "description": "Committed: the state is incorporated through the receipt's `seq`. CLI status 0.",
              "type": "string"
            }
          ]
        },
        "WriteReceipt": {
          "description": "The receipt of one public write (SS-10), independent of transport.\n\nSS-27 rule: every identifier that leaves a database is a UUID. `instance_id` and\n`pack_lineage_id` are the store's UUIDs; the record references of the enclosing response\n(node and edge ids, claim keys) are UUIDs or content hashes already; `seq` is a local\n`ChangeLog` position scoped by `instance_id`, never a record identity. No SQLite row id\n(`rid`, `rowid`) may appear in a receipt or beside it.",
          "properties": {
            "instance_id": {
              "description": "The database copy that answered: its `db_id` (SS-26 `instance_id`).",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/WriteOutcome",
              "description": "`rejected` or `committed` (see [`WriteOutcome`])."
            },
            "pack_lineage_id": {
              "description": "The pack lineage the database belongs to (SS-26; kept across forks and copies).",
              "type": "string"
            },
            "seq": {
              "description": "The `ChangeLog` position the outcome holds at. For `committed`, the call's terminal\nsequence: its last change row, read inside its transaction (the head at that moment\nwhen the call wrote no change row, so a no-op still names the state it saw); `None`\nonly when the position could not be read after the commit (the write stands; the\nservice logs the read failure). For `rejected`, `None`: nothing of the call is in the\nlog.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "outcome",
            "instance_id",
            "pack_lineage_id",
            "seq"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confidence": {
          "description": "0..1 confidence.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "from": {
          "description": "Source node id.",
          "type": "string"
        },
